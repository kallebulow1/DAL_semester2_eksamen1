## -----------------------------
## Hjælpefunktioner
## -----------------------------
get_metrics <- function(pred_class, truth, positive_class = "Goal") {
  cm <- confusionMatrix(
    factor(pred_class, levels = c("No", "Goal")),
    factor(truth, levels = c("No", "Goal")),
    positive = positive_class
  )
  
  tibble(
    Accuracy = unname(cm$overall["Accuracy"]),
    Kappa = unname(cm$overall["Kappa"]),
    Sensitivity = unname(cm$byClass["Sensitivity"]),
    Specificity = unname(cm$byClass["Specificity"]),
    Balanced_Accuracy = unname(cm$byClass["Balanced Accuracy"])
  )
}

get_metrics_from_prob <- function(prob, truth, threshold = 0.5) {
  pred_class <- ifelse(prob > threshold, "Goal", "No")
  get_metrics(pred_class, truth, positive_class = "Goal")
}

roc_to_df <- function(roc_obj) {
  tibble(
    specificity = roc_obj$specificities,
    sensitivity = roc_obj$sensitivities
  )
}

confusion_df <- function(pred_class, truth) {
  tab <- table(
    Prediction = factor(pred_class, levels = c("No", "Goal")),
    Actual = factor(truth, levels = c("No", "Goal"))
  )
  
  as.data.frame(tab)
}

