#### DEL 3 – TEST PÅ BRØNDBY I INDEVÆRENDE SÆSON ####

# Feature engineering på Brøndby-data
brondby_data <- brondby_raw %>%
  mutate(
    # RENS DATA (MEGET VIGTIG)
    clean_bodypart = str_replace_all(SHOTBODYPART, "[\\[\\]\\n\",]", ""),
    clean_bodypart = str_trim(clean_bodypart),
    
    # KORREKT målvariabel
    is_goal = as.integer(clean_bodypart == "goal"),
    
    # rydder bodypart op
    bodypart_detail = case_when(
      str_detect(clean_bodypart, "left") ~ "left_foot",
      str_detect(clean_bodypart, "right") ~ "right_foot",
      str_detect(clean_bodypart, "head") ~ "head",
      clean_bodypart == "goal" ~ "goal",
      TRUE ~ NA_character_
    ),
    
    # simpel version til model
    bodypart = case_when(
      bodypart_detail %in% c("left_foot", "right_foot") ~ "foot",
      bodypart_detail == "head" ~ "head",
      bodypart_detail == "goal" ~ "foot",
      TRUE ~ "other"
    ),
    
    # set piece-kategori
    set_piece_category = case_when(
      tolower(possession_start_type) == "corner" ~ "corner",
      tolower(possession_start_type) %in% c("free_kick", "penalty") ~ "free_kick_or_penalty",
      tolower(possession_start_type) %in% c("throw_in", "goal_kick") ~ "restart_other",
      TRUE ~ "open_play"
    ),
    
    # koordinater omregnes til meter
    x_meter = LOCATIONX * 105 / 100,
    y_meter = LOCATIONY * 68 / 100,
    goal_center_distance = abs(y_meter - 34),
    
    # distance til mål
    distance_meter = sqrt((105 - x_meter)^2 + (34 - y_meter)^2),
    
    # vinkel til mål
    goal_left_y  = 34 - 7.32 / 2,
    goal_right_y = 34 + 7.32 / 2,
    
    d_left  = sqrt((105 - x_meter)^2 + (goal_left_y - y_meter)^2),
    d_right = sqrt((105 - x_meter)^2 + (goal_right_y - y_meter)^2),
    
    cos_angle = (d_left^2 + d_right^2 - 7.32^2) / (2 * d_left * d_right),
    cos_angle = pmin(pmax(cos_angle, -1), 1),   # holder værdien mellem -1 og 1
    
    angle_deg = acos(cos_angle) * 180 / pi,
    
    possession_duration = POSSESSIONDURATION,
    
    # skud for eller imod Brøndby
    shot_for_or_against = ifelse(
      TEAM_WYID == 7453,
      "Brøndby for",
      "Brøndby against"
    )
  ) %>%
  filter(
    distance_meter < 60,
    angle_deg < 120
  ) %>%
  mutate(
    bodypart = factor(bodypart, levels = c("head", "foot", "other")),
    set_piece_category = factor(
      set_piece_category,
      levels = c("open_play", "corner", "free_kick_or_penalty", "restart_other")
    )
  )

# Samme model-features som i træningen
brondby_x <- model.matrix(
  is_goal ~ distance_meter + angle_deg + goal_center_distance + bodypart +
    possession_duration + set_piece_category - 1,
  data = brondby_data
)

# Sørger for at kolonner matcher træningsmodellen
missing_cols <- setdiff(colnames(train_x), colnames(brondby_x))

if (length(missing_cols) > 0) {
  for (col in missing_cols) {
    brondby_x <- cbind(brondby_x, 0)
    colnames(brondby_x)[ncol(brondby_x)] <- col
  }
}

