        div(class = "kpi-value", round(sum(filtered_data()$xg), 2)))
  })
  
  output$kpi_avg_xg <- renderUI({
    div(class = "kpi-box",
        div(class = "kpi-title", "Gns. xG pr. skud"),
        div(class = "kpi-value", round(mean(filtered_data()$xg), 3)))
  })
  
  output$summary_table <- renderDT({
    datatable(
      summary_filtered(),
      rownames = FALSE,
      options = list(dom = "t", pageLength = 5)
    )
  })
  
  output$goals_xg_plot <- renderPlot({
    plot_df <- summary_filtered() %>%
      select(shot_for_or_against, goals, total_xg) %>%
      pivot_longer(cols = c(goals, total_xg), names_to = "type", values_to = "value")
    
    ggplot(plot_df, aes(x = shot_for_or_against, y = value, fill = type)) +
      geom_col(position = position_dodge(width = 0.7), width = 0.6) +
      scale_fill_manual(values = c("goals" = "#002B7F", "total_xg" = "#FFD200")) +
      labs(x = NULL, y = "Værdi", fill = NULL) +
      theme_minimal(base_size = 14)
  })
  
  output$shot_plot <- renderPlot({
    ggplot(filtered_data(), aes(x = distance_meter, y = angle_deg)) +
      geom_point(aes(color = xg, shape = factor(is_goal)), alpha = 0.8, size = 3) +
      scale_color_gradient(low = "#FFE680", high = "#002B7F") +
      labs(
        x = "Distance til mål",
        y = "Vinkel",
        color = "xG",
        shape = "Udfald"
      ) +
      theme_minimal(base_size = 14)
  })
  
  output$importance_plot <- renderPlot({
    ggplot(
      importance_tbl %>% mutate(Feature = reorder(Feature, Gain)),
      aes(x = Feature, y = Gain)
    ) +
      geom_col(fill = "#002B7F") +
      coord_flip() +
      labs(x = NULL, y = "Gain") +
      theme_minimal(base_size = 14)
  })
  
  output$importance_table <- renderDT({
    datatable(
      importance_tbl,
      rownames = FALSE,
      options = list(dom = "t", pageLength = 10)
    )
  })
  
  output$top_shots <- renderDT({
    filtered_data() %>%
      arrange(desc(xg)) %>%
      select(
        shot_for_or_against,
        MATCH_WYID,
        PLAYER_WYID,
        MINUTE,
        SECOND,
        is_goal,
        bodypart,
        set_piece_category,
        distance_meter,
        angle_deg,
        possession_duration,
        xg
      ) %>%
      mutate(across(where(is.numeric), ~ round(.x, 3))) %>%
      slice_head(n = 15) %>%
      datatable(rownames = FALSE, options = list(pageLength = 15))
  })
}

shinyApp(ui, server)

