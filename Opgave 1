shots_raw <- dbGetQuery(con, "
WITH possession_start AS (
  SELECT
    POSSESSION_WYID,
    PRIMARYTYPE AS possession_start_type,
    ROW_NUMBER() OVER (
      PARTITION BY POSSESSION_WYID
      ORDER BY MATCH_WYID, MATCHPERIOD, MINUTE, SECOND, MATCHTIMESTAMP
    ) AS rn
  FROM wyscout_matchevents_common
  WHERE SEASON_WYID = 189918
    AND POSSESSION_WYID IS NOT NULL
)

SELECT
  s.EVENT_WYID,
  e.MATCH_WYID,
  e.MINUTE,
  e.SECOND,
  e.LOCATIONX,
  e.LOCATIONY,
  e.TEAM_WYID,
  e.OPPONENTTEAM_WYID,
  e.PLAYER_WYID,
  e.POSSESSION_WYID,
  e.POSSESSIONDURATION,
  s.SHOTISGOAL,
  s.SHOTBODYPART,
  ps.possession_start_type
FROM wyscout_matchevents_shots s
JOIN wyscout_matchevents_common e
  ON s.EVENT_WYID = e.EVENT_WYID
LEFT JOIN possession_start ps
  ON e.POSSESSION_WYID = ps.POSSESSION_WYID
 AND ps.rn = 1
WHERE e.SEASON_WYID = 189918
  AND LOWER(e.PRIMARYTYPE) = 'shot';
") %>%
  as_tibble()

## -----------------------------
## 2) Fjern dubletter + målvariabel
## -----------------------------
shots_clean <- shots_raw %>%
  distinct(EVENT_WYID, .keep_all = TRUE)

shots_clean <- shots_clean %>%
  mutate(
    is_goal = as.integer(
      SHOTISGOAL == 1 | str_detect(tolower(SHOTBODYPART), "goal")
    )
  )

table(shots_clean$SHOTBODYPART)

## -----------------------------
## 3) Body part (head / foot / other)
## -----------------------------
shots_clean <- shots_clean %>%
  mutate(
    # detaljeret (til analyse)
    bodypart_detail = case_when(
      str_detect(tolower(SHOTBODYPART), "left") ~ "left_foot",
      str_detect(tolower(SHOTBODYPART), "right") ~ "right_foot",
      str_detect(tolower(SHOTBODYPART), "head") ~ "head",
      TRUE ~ NA_character_
    ),
    
    # simpel (til model)
    bodypart = case_when(
      bodypart_detail %in% c("left_foot", "right_foot") ~ "foot",
      bodypart_detail == "head" ~ "head",
      TRUE ~ NA_character_
    )
  )

## -----------------------------
## 4) Set piece kategori
## -----------------------------
shots_clean <- shots_clean %>%
  mutate(
    set_piece_category = case_when(
      tolower(possession_start_type) == "corner" ~ "corner",
      tolower(possession_start_type) %in% c("free_kick", "penalty") ~ "free_kick_or_penalty",
      tolower(possession_start_type) %in% c("throw_in", "goal_kick") ~ "restart_other",
      TRUE ~ "open_play"
    )
  )

## -----------------------------
## 5) Feature engineering (distance + angle)
## -----------------------------
shots_clean <- shots_clean %>%
  mutate(
    x_meter = LOCATIONX * 105 / 100,
    y_meter = LOCATIONY * 68 / 100
  )

shots_clean <- shots_clean %>%
  mutate(
    distance_meter = sqrt((105 - x_meter)^2 + (34 - y_meter)^2)
  )

shots_clean <- shots_clean %>%
  mutate(
    goal_left_y  = 34 - 7.32 / 2,
    goal_right_y = 34 + 7.32 / 2,
    
    d_left  = sqrt((105 - x_meter)^2 + (goal_left_y - y_meter)^2),
    d_right = sqrt((105 - x_meter)^2 + (goal_right_y - y_meter)^2),
    
    cos_angle = (d_left^2 + d_right^2 - 7.32^2) / (2 * d_left * d_right),
    cos_angle = pmin(pmax(cos_angle, -1), 1),
    
    angle_deg = acos(cos_angle) * 180 / pi,
    
    possession_duration = POSSESSIONDURATION
  )

## -----------------------------
## 6) Data cleaning + outliers
## -----------------------------
xg_data <- shots_clean %>%
  filter(
    !is.na(is_goal), # fjern rækker uden mål-label
    !is.na(distance_meter), 
    !is.na(angle_deg),
    !is.na(bodypart),
    !is.na(set_piece_category),
    !is.na(possession_duration),
    distance_meter < 60,
    angle_deg < 120
  )
## -----------------------------
## 7) Udvælg relevante variable
## -----------------------------
xg_data <- xg_data %>%
  select(
    EVENT_WYID,
    MATCH_WYID,
    TEAM_WYID,
    OPPONENTTEAM_WYID,
