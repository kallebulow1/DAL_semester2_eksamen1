library(caret)
library(rpart)
library(randomForest)
library(xgboost)
library(pROC)

## ---------------------------
## 1) Klargør target til caret
## caret vil ikke have factor-levels som 0 og 1
## derfor bruger vi "No" og "Goal"
## ---------------------------
train_data$is_goal <- factor(
  train_data$is_goal,
  levels = c(0, 1),
  labels = c("No", "Goal")
)

test_data$is_goal <- factor(
  test_data$is_goal,
  levels = c(0, 1),
  labels = c("No", "Goal")
)

## ---------------------------
## 2) Cross validation setup
## ---------------------------
control <- trainControl(
  method = "cv",
  number = 5,
  classProbs = TRUE
)

## ---------------------------
## 3) Beslutningstræ
## ---------------------------
tree_model <- train(
  is_goal ~ distance_meter + angle_deg + bodypart +
    possession_duration + set_piece_category,
  data = train_data,
  method = "rpart",
  trControl = control
)

## ---------------------------
## 4) Random Forest
## ---------------------------
rf_model <- train(
  is_goal ~ distance_meter + angle_deg + bodypart +
    possession_duration + set_piece_category,
  data = train_data,
  method = "rf",
  trControl = control,
  ntree = 300
)

## ---------------------------
## 5) XGBoost
## XGBoost skal have numerisk target (0/1)
## og kun de rigtige forklarende variable
## ---------------------------

# model.matrix laver kategoriske variable om til dummy-variable
train_x <- model.matrix(
  is_goal ~ distance_meter + angle_deg + bodypart +
    possession_duration + set_piece_category - 1,
  data = train_data
)

test_x <- model.matrix(
  is_goal ~ distance_meter + angle_deg + bodypart +
    possession_duration + set_piece_category - 1,
  data = test_data
)

# numerisk target til xgboost
train_y <- ifelse(train_data$is_goal == "Goal", 1, 0)
test_y  <- ifelse(test_data$is_goal == "Goal", 1, 0)

# xgboost model
xgb_model <- xgboost(
  x = train_x,
  y = train_y,
  nrounds = 50,
  max_depth = 3,
  learning_rate = 0.1,
  eval_metric = "logloss",
  verbosity = 0
)

## ---------------------------
## 6) Klassifikation og confusion matrix
## ---------------------------

# Decision tree
pred_tree <- predict(tree_model, test_data)
confusionMatrix(pred_tree, test_data$is_goal)

# Random Forest
pred_rf <- predict(rf_model, test_data)
confusionMatrix(pred_rf, test_data$is_goal)

# XGBoost sandsynligheder
pred_xgb <- predict(xgb_model, test_x)

# standard threshold 0.5
pred_xgb_class <- ifelse(pred_xgb > 0.5, "Goal", "No")
pred_xgb_class <- factor(pred_xgb_class, levels = c("No", "Goal"))

confusionMatrix(pred_xgb_class, test_data$is_goal)

## ---------------------------
## 7) Threshold-eksperimenter
## Tester om XGBoost bliver bedre til at fange mål
## ---------------------------
pred_xgb_class_02 <- factor(
  ifelse(pred_xgb > 0.2, "Goal", "No"),
  levels = c("No", "Goal")
)

pred_xgb_class_03 <- factor(
  ifelse(pred_xgb > 0.3, "Goal", "No"),
  levels = c("No", "Goal")
)

pred_xgb_class_04 <- factor(
  ifelse(pred_xgb > 0.4, "Goal", "No"),
  levels = c("No", "Goal")
)

confusionMatrix(pred_xgb_class_02, test_data$is_goal)
confusionMatrix(pred_xgb_class_03, test_data$is_goal)
confusionMatrix(pred_xgb_class_04, test_data$is_goal)

## ---------------------------
## 8) ROC og AUC
## Her bruger vi sandsynligheder i stedet for klasser
## ---------------------------

# XGBoost
roc_xgb <- roc(test_y, pred_xgb)
auc_xgb <- auc(roc_xgb)

# Decision Tree
pred_tree_prob <- predict(tree_model, test_data, type = "prob")[, "Goal"]
roc_tree <- roc(test_y, pred_tree_prob)
auc_tree <- auc(roc_tree)

# Random Forest
pred_rf_prob <- predict(rf_model, test_data, type = "prob")[, "Goal"]
roc_rf <- roc(test_y, pred_rf_prob)
auc_rf <- auc(roc_rf)

# samlet ROC-plot
plot(roc_tree, col = "blue")
lines(roc_rf, col = "green")
lines(roc_xgb, col = "red")

legend(
  "bottomright",
  legend = c(
    paste("Tree AUC =", round(auc_tree, 3)),
    paste("RF AUC =", round(auc_rf, 3)),
    paste("XGB AUC =", round(auc_xgb, 3))
  ),
  col = c("blue", "green", "red"),
  lwd = 2
)

