# ---- Hent afleveringsdata ----
df_pass <- dbGetQuery(con_superliga2, "
SELECT
  p.MATCH_WYID,
  p.EVENT_WYID,
  p.ACCURATE,
  p.ANGLE,
  p.HEIGHT,
  p.LENGTH,
  p.RECIPIENT_WYID,
  p.ENDLOCATIONX,
  p.ENDLOCATIONY,

  c.SEASON_WYID,
  c.MINUTE,
  c.SECOND,
  c.MATCHPERIOD,
  c.PRIMARYTYPE,
  c.LOCATIONX,
  c.LOCATIONY,
  c.PLAYER_WYID,
  c.TEAM_WYID,

  pl.SHORTNAME,
  pl.ROLENAME,
  t.TEAMNAME

FROM wyscout_matchevents_passes p
JOIN wyscout_matchevents_common c
  ON p.MATCH_WYID = c.MATCH_WYID
 AND p.EVENT_WYID = c.EVENT_WYID
JOIN wyscout_players pl
  ON c.PLAYER_WYID = pl.PLAYER_WYID
LEFT JOIN wyscout_teams t
  ON c.TEAM_WYID = t.TEAM_WYID
JOIN wyscout_matches m
  ON p.MATCH_WYID = m.MATCH_WYID
WHERE m.SEASON_WYID IN (189918, 191611)
")

# ---- Fjern dubletter ----
df_pass <- df_pass %>%
  distinct(MATCH_WYID, EVENT_WYID, .keep_all = TRUE)
table(df_pass$PRIMARYTYPE)


# ---- Behold kun afleveringer ----
passes_forrige <- df_pass %>%
  filter(SEASON_WYID == 189918, PRIMARYTYPE == "pass")

passes_indevaerende <- df_pass %>%
  filter(SEASON_WYID == 191611, PRIMARYTYPE == "pass")



# ---- Filtrer afleveringer i forrige sæson ----
# Koden gennemgår alle kampe og alle hold i hver kamp og filtrerer afleveringerne, 
# så kun de afleveringer, hvor modtageren er en medspiller fra samme hold, bliver beholdt. 
# Resultatet er et samlet datasæt med afleveringer, der med stor sandsynlighed er succesfulde.

#Opret tomt dataframe til filtrerede afleveringer
filtered_df_forrige <- data.frame()

#Loop gennem alle kampe
for (j in 1:length(unique(passes_forrige$MATCH_WYID))) {
  
  #Udvælg én kamp
  match1 <- passes_forrige %>%
    filter(MATCH_WYID == unique(passes_forrige$MATCH_WYID)[j])
  
  #Find hold i kampen
  teamz <- unique(match1$TEAM_WYID)
  
  #Loop gennem hvert hold
  for (i in 1:length(teamz)) {
    
    #Filtrer afleveringer for ét hold
    filtered_df2 <- match1 %>%
      filter(TEAM_WYID == teamz[i])
    
    #Behold afleveringer til medspillere
    filtered_df1 <- filtered_df2 %>%
      filter(RECIPIENT_WYID %in% unique(filtered_df2$PLAYER_WYID))
    
    #Tilføj til samlet datasæt
    filtered_df_forrige <- rbind(filtered_df_forrige, filtered_df1)
  }
}

# ---- Filtrer afleveringer i indeværende sæson ----
# Opret tomt dataframe til filtrerede afleveringer
filtered_df_indevaerende <- data.frame()

# Loop gennem alle kampe
for (j in 1:length(unique(passes_indevaerende$MATCH_WYID))) {
  
  # Udvælg én kamp
  match1 <- passes_indevaerende %>%
    filter(MATCH_WYID == unique(passes_indevaerende$MATCH_WYID)[j])
  
  # Find hold i kampen
  teamz <- unique(match1$TEAM_WYID)
  
  # Loop gennem hvert hold
  for (i in 1:length(teamz)) {
    
    # Filtrer afleveringer for ét hold
    filtered_df2 <- match1 %>%
      filter(TEAM_WYID == teamz[i])
    
    # Behold afleveringer til medspillere
    filtered_df1 <- filtered_df2 %>%
      filter(RECIPIENT_WYID %in% unique(filtered_df2$PLAYER_WYID))
    
    # Tilføj til samlet datasæt
    filtered_df_indevaerende <- rbind(filtered_df_indevaerende, filtered_df1)
  }
}

# ---- Saml begge sæsoner ----
filtered_df <- bind_rows(filtered_df_forrige, filtered_df_indevaerende)

# ---- Alle afleveringer pr. spiller ----
all_passes_player <- df_pass %>%
  filter(PRIMARYTYPE == "pass") %>%
  group_by(SEASON_WYID, TEAM_WYID, TEAMNAME, PLAYER_WYID, SHORTNAME, ROLENAME) %>%
  summarise(
    total_passes = n(),
    avg_length = mean(LENGTH, na.rm = TRUE),
    long_pass_rate = mean(LENGTH > 30, na.rm = TRUE),
    forward_pass_rate = mean(ENDLOCATIONX > LOCATIONX, na.rm = TRUE),
    avg_angle = mean(abs(ANGLE), na.rm = TRUE),
    .groups = "drop"
  )

# ---- Korrekte afleveringer pr. spiller ----
accurate_passes_player <- filtered_df %>%
  group_by(SEASON_WYID, TEAM_WYID, TEAMNAME, PLAYER_WYID, SHORTNAME, ROLENAME) %>%
  summarise(
    accurate_passes = n(),
    .groups = "drop"
  )

# ---- Saml og lav accuracy ----
player_pass <- all_passes_player %>%
  left_join(
    accurate_passes_player,
    by = c("SEASON_WYID", "TEAM_WYID", "TEAMNAME", "PLAYER_WYID", "SHORTNAME", "ROLENAME")
  ) %>%
  mutate(
    accurate_passes = ifelse(is.na(accurate_passes), 0, accurate_passes),
    accuracy = accurate_passes / total_passes
  ) %>%
  filter(total_passes >= 30)

# ---- Vælg variable til clustering ----
cluster_data <- player_pass %>%
  select(
    accuracy,
    avg_length,
    long_pass_rate,
    forward_pass_rate,
    avg_angle
  )

# ---- Standardiser data ----
cluster_scaled <- scale(cluster_data)

# ---- Elbow plot ----
wss <- numeric(10)

set.seed(123)
for (i in 1:10) {
  wss[i] <- kmeans(cluster_scaled, centers = i, nstart = 20)$tot.withinss
}

elbow_df <- data.frame(
  k = 1:10,
  wss = wss
)

# plotte elbow 
ggplot(elbow_df, aes(x = k, y = wss)) +
  geom_line(linewidth = 0.7) +
  geom_point(size = 2) +
  geom_vline(xintercept = 3, linetype = "dashed", linewidth = 0.5) +
  scale_x_continuous(
    breaks = 1:10,
    limits = c(1, 10)
  ) +
  scale_y_continuous(
    breaks = seq(0, 3000, by = 500),
    labels = label_number(big.mark = ".", decimal.mark = ",")
  ) +
  labs(
    title = "Elbow plot for valg af antal cluster",
    subtitle = "Et tydeligt knæk ses ved c = 3",
    x = "Antal cluster (c)",
    y = "WSS"
  ) +
  theme_classic(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 14),
    plot.subtitle = element_text(size = 11, margin = margin(b = 8)),
    axis.title = element_text(face = "bold"),
    axis.text = element_text(size = 10)
  )

# ---- K-means model ----
set.seed(123)
k_model <- kmeans(cluster_scaled, centers = 3, nstart = 30)

# ---- Sæt cluster på spillerdata ----
player_pass$cluster <- as.factor(k_model$cluster)

# ---- Giv clusters navne ----
cluster_labels <- c(
  "1" = "Direkte afleverere",
  "2" = "Korte og sikre afleverere",
  "3" = "Længere og mere risikovillige afleverere"
)

player_pass <- player_pass %>%
  mutate(cluster_name = recode(cluster, !!!cluster_labels))

# ---- Cluster summary ----
cluster_summary <- player_pass %>%
  group_by(cluster, cluster_name) %>%
  summarise(
    antal_spillere = n(),
    total_passes = round(mean(total_passes, na.rm = TRUE), 1),
    accurate_passes = round(mean(accurate_passes, na.rm = TRUE), 1),
    accuracy = round(mean(accuracy, na.rm = TRUE), 3),
    avg_length = round(mean(avg_length, na.rm = TRUE), 1),
    long_pass_rate = round(mean(long_pass_rate, na.rm = TRUE), 3),
    forward_pass_rate = round(mean(forward_pass_rate, na.rm = TRUE), 3),
    avg_angle = round(mean(avg_angle, na.rm = TRUE), 1),
    .groups = "drop"
  )

# ---- Lav scatterplot ---- 
ggplot(player_pass, aes(x = accuracy, y = avg_length, color = cluster_name)) +
  
  # Punkter (spillere)
  geom_point(size = 3, alpha = 0.8) +
  
  # Labels (valgfri – kan fjernes hvis for crowded)
