# ---- SERVER ----
server <- function(input, output, session) {
  
  filtered_brondby <- reactive({
    data <- brondby_data %>%
      filter(
        SEASON_WYID == input$season_filter,
        total_passes >= input$min_passes
      )
    
    if (input$brondby_role_filter != "Alle") {
      data <- data %>% filter(ROLENAME == input$brondby_role_filter)
    }
    
    data
  })
  
  league_data <- reactive({
    player_pass %>%
      filter(
        SEASON_WYID == input$season_filter,
        total_passes >= input$min_passes
      )
  })
  
  scout_data <- reactive({
    data <- player_pass %>%
      filter(
        SEASON_WYID == input$season_filter,
        total_passes >= input$min_passes
      )
    
    if (input$scout_team_filter != "Alle") {
      data <- data %>% filter(TEAMNAME == input$scout_team_filter)
    }
    
    if (input$scout_role_filter != "Alle") {
      data <- data %>% filter(ROLENAME == input$scout_role_filter)
    }
    
    if (!is.null(input$scout_player_filter) && length(input$scout_player_filter) > 0) {
      data <- data %>% filter(SHORTNAME %in% input$scout_player_filter)
    }
    
    data
  })
  
  observe({
    available_players <- player_pass %>%
      filter(
        SEASON_WYID == input$season_filter,
        total_passes >= input$min_passes
      )
    
    if (input$scout_team_filter != "Alle") {
      available_players <- available_players %>%
        filter(TEAMNAME == input$scout_team_filter)
    }
    
    if (input$scout_role_filter != "Alle") {
      available_players <- available_players %>%
        filter(ROLENAME == input$scout_role_filter)
    }
    
    updateSelectizeInput(
      session,
      "scout_player_filter",
      choices = sort(unique(available_players$SHORTNAME)),
      server = TRUE
    )
  })
  
  # KPI
  output$kpi_players <- renderUI({
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Spillere i visningen"),
      div(class = "kpi-value", nrow(filtered_brondby())),
      div(class = "kpi-sub", "Antal Brøndby-spillere efter filter")
    )
  })
  
  output$kpi_accuracy <- renderUI({
    val <- mean(filtered_brondby()$accuracy, na.rm = TRUE)
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Gns. præcision"),
      div(class = "kpi-value", percent(val, accuracy = 0.1)),
      div(class = "kpi-sub", "Brøndbys afleveringspræcision")
    )
  })
  
  output$kpi_length <- renderUI({
    val <- mean(filtered_brondby()$avg_length, na.rm = TRUE)
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Gns. længde"),
      div(class = "kpi-value", round(val, 1)),
      div(class = "kpi-sub", "Gennemsnitlig afleveringslængde")
    )
  })
  
  output$kpi_forward <- renderUI({
    val <- mean(filtered_brondby()$forward_pass_rate, na.rm = TRUE)
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Fremadrettede afleveringer"),
      div(class = "kpi-value", percent(val, accuracy = 0.1)),
      div(class = "kpi-sub", "Andel afleveringer spillet fremad")
    )
  })
  
  # Brøndby scatter
  output$brondby_scatter <- renderPlotly({
    req(nrow(filtered_brondby()) > 0)
    req(input$xvar != input$yvar)
    
    plot_ly(
      data = filtered_brondby(),
      x = as.formula(paste0("~", input$xvar)),
      y = as.formula(paste0("~", input$yvar)),
      color = ~cluster_name,
      colors = cluster_colors,
      type = "scatter",
      mode = "markers",
      marker = list(size = 12, opacity = 0.85),
      text = ~paste0(
        "<b>", SHORTNAME, "</b>",
        "<br>Hold: ", TEAMNAME,
        "<br>Position: ", ROLENAME,
        "<br>Cluster: ", cluster_name,
        "<br>Antal afleveringer: ", total_passes,
        "<br>Præcision: ", percent(accuracy, accuracy = 0.1),
        "<br>Gns. længde: ", round(avg_length, 1),
        "<br>Lange afleveringer: ", percent(long_pass_rate, accuracy = 0.1),
        "<br>Fremadrettede afleveringer: ", percent(forward_pass_rate, accuracy = 0.1),
        "<br>Gns. vinkel: ", round(avg_angle, 1)
      ),
      hoverinfo = "text"
    ) %>%
      layout(
        title = list(text = "<b>Afleveringsprofiler blandt Brøndby-spillere</b>"),
        xaxis = list(title = pretty_var(input$xvar)),
        yaxis = list(title = pretty_var(input$yvar)),
        legend = list(orientation = "h", x = 0.05, y = -0.15),
        plot_bgcolor = "white",
        paper_bgcolor = "white"
      )
  })
  
  # Cluster bar
  output$cluster_bar <- renderPlot({
    all_clusters <- data.frame(
      cluster_name = c(
        "Direkte afleverere",
        "Korte og sikre afleverere",
        "Længere og mere risikovillige afleverere"
      )
    )
    
    cluster_df <- filtered_brondby() %>%
      count(cluster_name) %>%
      right_join(all_clusters, by = "cluster_name") %>%
      mutate(n = ifelse(is.na(n), 0, n))
    
    ggplot(cluster_df, aes(x = cluster_name, y = n, fill = cluster_name)) +
      geom_col(width = 0.7) +
      scale_fill_manual(values = cluster_colors) +
      labs(
        x = NULL,
        y = "Antal spillere"
      ) +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "none",
        axis.text.x = element_text(angle = 15, hjust = 1, face = "bold"),
        panel.grid.minor = element_blank()
      )
  })
  
  # Compare
  output$compare_plot <- renderPlot({
    br <- filtered_brondby() %>%
      summarise(
        accuracy = mean(accuracy, na.rm = TRUE),
        avg_length = mean(avg_length, na.rm = TRUE),
        forward_pass_rate = mean(forward_pass_rate, na.rm = TRUE)
      ) %>%
      mutate(type = "Brøndby")
    
    lg <- league_data() %>%
      summarise(
        accuracy = mean(accuracy, na.rm = TRUE),
        avg_length = mean(avg_length, na.rm = TRUE),
        forward_pass_rate = mean(forward_pass_rate, na.rm = TRUE)
      ) %>%
      mutate(type = "Liga")
    
    compare_df <- bind_rows(br, lg) %>%
      pivot_longer(
        cols = c(accuracy, avg_length, forward_pass_rate),
        names_to = "metric",
        values_to = "value"
      ) %>%
      mutate(
        metric = recode(
          metric,
          "accuracy" = "Præcision",
          "avg_length" = "Længde",
          "forward_pass_rate" = "Fremad"
        )
      )
    
    ggplot(compare_df, aes(x = metric, y = value, fill = type)) +
      geom_col(position = "dodge", width = 0.7) +
      scale_fill_manual(values = c("Brøndby" = brondby_yellow, "Liga" = "#C7CED9")) +
      labs(
        x = NULL,
        y = NULL,
        fill = NULL
      ) +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "bottom",
        axis.text.x = element_text(face = "bold"),
        panel.grid.minor = element_blank()
      )
  })
  
  # Brøndby tabel
  output$brondby_table <- renderDT({
    tbl <- filtered_brondby() %>%
      mutate(
        accuracy = percent(accuracy, accuracy = 0.1),
        long_pass_rate = percent(long_pass_rate, accuracy = 0.1),
        forward_pass_rate = percent(forward_pass_rate, accuracy = 0.1),
        avg_length = round(avg_length, 1),
        avg_angle = round(avg_angle, 1)
      ) %>%
      select(
        Spiller = SHORTNAME,
        Position = ROLENAME,
        Cluster = cluster_name,
        `Antal afleveringer` = total_passes,
        `Præcision` = accuracy,
        `Gns. længde` = avg_length,
        `Lange afleveringer` = long_pass_rate,
        `Fremadrettede afleveringer` = forward_pass_rate,
        `Gns. vinkel` = avg_angle
      ) %>%
      arrange(desc(`Antal afleveringer`))
    
    datatable(
      tbl,
      rownames = FALSE,
      filter = "top",
      options = list(
        pageLength = 10,
        autoWidth = TRUE,
        scrollX = TRUE
      )
    )
  })
  
  # Scouting scatter
  output$scout_scatter <- renderPlotly({
    req(nrow(scout_data()) > 0)
    req(input$xvar != input$yvar)
    
    plot_ly(
      data = scout_data(),
      x = as.formula(paste0("~", input$xvar)),
      y = as.formula(paste0("~", input$yvar)),
      color = ~cluster_name,
      colors = cluster_colors,
      type = "scatter",
      mode = "markers",
      marker = list(size = 11, opacity = 0.80),
      text = ~paste0(
        "<b>", SHORTNAME, "</b>",
        "<br>Hold: ", TEAMNAME,
        "<br>Position: ", ROLENAME,
        "<br>Cluster: ", cluster_name,
        "<br>Antal afleveringer: ", total_passes,
        "<br>Præcision: ", percent(accuracy, accuracy = 0.1),
        "<br>Gns. længde: ", round(avg_length, 1),
        "<br>Lange afleveringer: ", percent(long_pass_rate, accuracy = 0.1),
        "<br>Fremadrettede afleveringer: ", percent(forward_pass_rate, accuracy = 0.1),
        "<br>Gns. vinkel: ", round(avg_angle, 1)
      ),
      hoverinfo = "text"
    ) %>%
      layout(
        title = list(text = "<b>Scouting på tværs af ligaen</b>"),
        xaxis = list(title = pretty_var(input$xvar)),
        yaxis = list(title = pretty_var(input$yvar)),
        legend = list(orientation = "h", x = 0.05, y = -0.15),
        plot_bgcolor = "white",
        paper_bgcolor = "white"
      )
  })
  
  # Scouting tabel
  output$scout_table <- renderDT({
    tbl <- scout_data() %>%
      mutate(
        accuracy = percent(accuracy, accuracy = 0.1),
        long_pass_rate = percent(long_pass_rate, accuracy = 0.1),
        forward_pass_rate = percent(forward_pass_rate, accuracy = 0.1),
        avg_length = round(avg_length, 1),
        avg_angle = round(avg_angle, 1)
      ) %>%
      select(
        Hold = TEAMNAME,
        Spiller = SHORTNAME,
        Position = ROLENAME,
        Cluster = cluster_name,
        `Antal afleveringer` = total_passes,
        `Præcision` = accuracy,
        `Gns. længde` = avg_length,
        `Lange afleveringer` = long_pass_rate,
        `Fremadrettede afleveringer` = forward_pass_rate,
        `Gns. vinkel` = avg_angle
      ) %>%
      arrange(Hold, desc(`Antal afleveringer`))
    
    datatable(
      tbl,
      rownames = FALSE,
      filter = "top",
      options = list(
        pageLength = 12,
        autoWidth = TRUE,
        scrollX = TRUE
      )
    )
  })
  
  # Elbow plot
  output$elbow <- renderPlot({
    ggplot(elbow_df, aes(k, wss)) +
      geom_line(linewidth = 1.1, color = brondby_blue) +
      geom_point(size = 3.5, color = brondby_yellow) +
      geom_vline(xintercept = 3, linetype = "dashed", color = "grey40") +
      labs(
        title = "Elbow plot for valg af antal clusters",
        subtitle = "Kurven peger på 3 meningsfulde afleveringsprofiler",
        x = "Antal clusters",
        y = "WSS"
      ) +
      theme_minimal(base_size = 13) +
      theme(
        plot.title = element_text(face = "bold"),
        plot.subtitle = element_text(color = muted_text),
        panel.grid.minor = element_blank()
      )
  })
}

shinyApp(ui, server)
