    "Direkte afleverere" = "#2ca02c",
    "Længere og mere risikovillige afleverere" = "#d62728"
  )) +
  
  # Titler
  labs(
    title = "Afleveringsprofiler blandt spillere",
    subtitle = "Sammenhæng mellem afleveringspræcision og gennemsnitlig længde",
    x = "Afleveringspræcision",
    y = "Gns. afleveringslængde",
    color = "Cluster"
  ) +
  
  # Tema (gør det pænt til opgave)
  theme_minimal() +
  
  theme(
    plot.title = element_text(size = 16, face = "bold"),
    plot.subtitle = element_text(size = 12),
    legend.position = "bottom"
  )





