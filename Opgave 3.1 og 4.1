pretty_var <- function(x) {
  dplyr::case_when(
    x == "accuracy" ~ "Afleveringspræcision",
    x == "avg_length" ~ "Gns. afleveringslængde",
    x == "long_pass_rate" ~ "Andel lange afleveringer",
    x == "forward_pass_rate" ~ "Andel fremadrettede afleveringer",
    x == "avg_angle" ~ "Gns. vinkel",
    x == "total_passes" ~ "Antal afleveringer",
    TRUE ~ x
  )
}

