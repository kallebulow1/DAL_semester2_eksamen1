# ---- SERVER ----
server <- function(input, output, session) {
  
  filtered_brondby <- reactive({
    data <- kamp_data %>%
      filter(grepl("Brøndby", TEAMNAME, ignore.case = TRUE))
    
    if (input$result_filter != "Alle") {
      data <- data %>% filter(result == input$result_filter)
    }
    
    if (input$cluster_filter != "Alle") {
      data <- data %>% filter(cluster_name == input$cluster_filter)
    }
    
    data
  })
  
  league_data <- reactive({
    data <- kamp_data
    
    if (input$league_team_filter != "Alle") {
      data <- data %>% filter(TEAMNAME == input$league_team_filter)
    }
    
    if (input$league_result_filter != "Alle") {
      data <- data %>% filter(result == input$league_result_filter)
    }
    
    if (input$league_cluster_filter != "Alle") {
      data <- data %>% filter(cluster_name == input$league_cluster_filter)
    }
    
    data
  })
  
  output$kpi_matches <- renderUI({
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Kampe i visningen"),
      div(class = "kpi-value", nrow(filtered_brondby())),
      div(class = "kpi-sub", "Antal Brøndby-kampe efter filter")
    )
  })
  
  output$kpi_points <- renderUI({
    val <- sum(filtered_brondby()$points, na.rm = TRUE)
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Point"),
      div(class = "kpi-value", val),
      div(class = "kpi-sub", "Samlede point i de viste kampe")
    )
  })
  
  output$kpi_xg <- renderUI({
    val <- mean(filtered_brondby()$XG, na.rm = TRUE)
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Gns. xG"),
      div(class = "kpi-value", round(val, 2)),
      div(class = "kpi-sub", "Brøndbys gennemsnitlige xG")
    )
  })
  
  output$kpi_goals <- renderUI({
    val <- mean(filtered_brondby()$GOALS, na.rm = TRUE)
    div(
      class = "kpi-card",
      div(class = "kpi-title", "Gns. mål"),
      div(class = "kpi-value", round(val, 2)),
      div(class = "kpi-sub", "Brøndbys gennemsnitlige antal mål")
    )
  })
  
  output$brondby_scatter <- renderPlotly({
    req(nrow(filtered_brondby()) > 0)
    req(input$xvar != input$yvar)
    
    plot_ly(
      data = filtered_brondby(),
      x = as.formula(paste0("~", input$xvar)),
      y = as.formula(paste0("~", input$yvar)),
      color = ~cluster_name,
      colors = cluster_colors,
      type = "scatter",
      mode = "markers",
      marker = list(size = 12, opacity = 0.85),
      text = ~paste0(
        "<b>", TEAMNAME, "</b>",
        "<br>Modstander: ", opponent_name,
        "<br>Resultat: ", result,
        "<br>Kamptype: ", cluster_name,
        "<br>Point: ", points,
        "<br>xG: ", round(XG, 2),
        "<br>Skud: ", SHOTS,
        "<br>Skud på mål: ", SHOTSONTARGET,
        "<br>Mål: ", GOALS,
        "<br>Berøringer i feltet: ", TOUCHESINBOX,
        "<br>Driblinger: ", DRIBBLES,
        "<br>Progressive løb: ", PROGRESSIVERUNS,
        "<br>Gns. afslutningsafstand: ", round(AVGDISTANCE, 2)
      ),
      hoverinfo = "text"
    ) %>%
      layout(
        title = list(text = "<b>Brøndbys kampprofiler</b>"),
        xaxis = list(title = pretty_var(input$xvar)),
        yaxis = list(title = pretty_var(input$yvar)),
        legend = list(orientation = "h", x = 0.05, y = -0.15),
        plot_bgcolor = "white",
        paper_bgcolor = "white"
      )
  })
  
  output$cluster_bar <- renderPlot({
    all_clusters <- data.frame(
      cluster_name = c(
        "Lukkede og chancefattige kampe",
        "Åbne og chanceprægede kampe"
      )
    )
    
    cluster_df <- filtered_brondby() %>%
      count(cluster_name) %>%
      right_join(all_clusters, by = "cluster_name") %>%
      mutate(n = ifelse(is.na(n), 0, n))
    
    ggplot(cluster_df, aes(x = cluster_name, y = n, fill = cluster_name)) +
      geom_col(width = 0.7) +
      scale_fill_manual(values = cluster_colors) +
      labs(
        x = NULL,
        y = "Antal kampe"
      ) +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "none",
        axis.text.x = element_text(angle = 12, hjust = 1, face = "bold"),
        panel.grid.minor = element_blank()
      )
  })
  
  output$compare_plot <- renderPlot({
    br <- filtered_brondby() %>%
      summarise(
        XG = mean(XG, na.rm = TRUE),
        SHOTS = mean(SHOTS, na.rm = TRUE),
        GOALS = mean(GOALS, na.rm = TRUE)
      ) %>%
      mutate(type = "Brøndby")
    
    lg <- kamp_data %>%
      summarise(
        XG = mean(XG, na.rm = TRUE),
        SHOTS = mean(SHOTS, na.rm = TRUE),
        GOALS = mean(GOALS, na.rm = TRUE)
      ) %>%
      mutate(type = "Liga")
    
    compare_df <- bind_rows(br, lg) %>%
      pivot_longer(
        cols = c(XG, SHOTS, GOALS),
        names_to = "metric",
        values_to = "value"
      ) %>%
      mutate(
        metric = recode(
          metric,
          "XG" = "xG",
          "SHOTS" = "Skud",
          "GOALS" = "Mål"
        )
      )
    
    ggplot(compare_df, aes(x = metric, y = value, fill = type)) +
      geom_col(position = "dodge", width = 0.7) +
      scale_fill_manual(values = c("Brøndby" = brondby_yellow, "Liga" = "#C7CED9")) +
      labs(
        x = NULL,
        y = NULL,
        fill = NULL
      ) +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "bottom",
        axis.text.x = element_text(face = "bold"),
        panel.grid.minor = element_blank()
      )
  })
  
  output$result_bar <- renderPlot({
    result_df <- filtered_brondby() %>%
      count(result)
    
    all_results <- data.frame(result = c("Sejr", "Uafgjort", "Nederlag"))
    
    result_df <- all_results %>%
      left_join(result_df, by = "result") %>%
      mutate(n = ifelse(is.na(n), 0, n))
    
    ggplot(result_df, aes(x = result, y = n, fill = result)) +
      geom_col(width = 0.7) +
      scale_fill_manual(values = result_colors) +
      labs(
        x = NULL,
        y = "Antal kampe"
      ) +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "none",
        axis.text.x = element_text(face = "bold"),
        panel.grid.minor = element_blank()
      )
  })
  
  output$opponent_cluster_plot <- renderPlot({
    req(nrow(filtered_brondby()) > 0)
    
    plot_df <- filtered_brondby() %>%
      group_by(opponent_name, cluster_name) %>%
      summarise(antal_kampe = n(), .groups = "drop")
    
    ggplot(plot_df, aes(x = opponent_name, y = antal_kampe, fill = cluster_name)) +
      geom_col(position = "fill") +
      coord_flip() +
      scale_y_continuous(labels = percent_format()) +
      scale_fill_manual(values = cluster_colors) +
      labs(
        x = "Modstander",
        y = "Andel af kampe",
        fill = "Kamptype"
      ) +
      theme_minimal(base_size = 13) +
      theme(
        legend.position = "bottom",
        panel.grid.minor = element_blank()
      )
  })
  
  output$brondby_table <- renderDT({
    tbl <- filtered_brondby() %>%
      mutate(
        XG = round(XG, 2),
        AVGDISTANCE = round(AVGDISTANCE, 2)
      ) %>%
      select(
        Modstander = opponent_name,
        Resultat = result,
        Kamptype = cluster_name,
        Point = points,
        xG = XG,
        Skud = SHOTS,
        `Skud på mål` = SHOTSONTARGET,
        Mål = GOALS,
        `Berøringer i feltet` = TOUCHESINBOX,
        Driblinger = DRIBBLES,
        `Progressive løb` = PROGRESSIVERUNS,
        `Gns. afslutningsafstand` = AVGDISTANCE
      ) %>%
      arrange(desc(Point), desc(xG))
    
    datatable(
      tbl,
      rownames = FALSE,
      filter = "top",
      options = list(
        pageLength = 10,
        autoWidth = TRUE,
        scrollX = TRUE
      )
    )
  })
  
  output$league_scatter <- renderPlotly({
    req(nrow(league_data()) > 0)
    req(input$xvar != input$yvar)
    
    plot_ly(
      data = league_data(),
      x = as.formula(paste0("~", input$xvar)),
      y = as.formula(paste0("~", input$yvar)),
      color = ~cluster_name,
      colors = cluster_colors,
      type = "scatter",
      mode = "markers",
      marker = list(size = 11, opacity = 0.80),
      text = ~paste0(
        "<b>", TEAMNAME, "</b>",
        "<br>Modstander: ", opponent_name,
        "<br>Resultat: ", result,
        "<br>Kamptype: ", cluster_name,
        "<br>Point: ", points,
        "<br>xG: ", round(XG, 2),
        "<br>Skud: ", SHOTS,
        "<br>Skud på mål: ", SHOTSONTARGET,
        "<br>Mål: ", GOALS,
        "<br>Berøringer i feltet: ", TOUCHESINBOX
      ),
      hoverinfo = "text"
    ) %>%
      layout(
        title = list(text = "<b>Kampprofiler på tværs af ligaen</b>"),
        xaxis = list(title = pretty_var(input$xvar)),
        yaxis = list(title = pretty_var(input$yvar)),
        legend = list(orientation = "h", x = 0.05, y = -0.15),
        plot_bgcolor = "white",
        paper_bgcolor = "white"
      )
  })
  
  output$league_table <- renderDT({
    tbl <- league_data() %>%
      mutate(
        XG = round(XG, 2),
        AVGDISTANCE = round(AVGDISTANCE, 2)
      ) %>%
      select(
        Hold = TEAMNAME,
        Modstander = opponent_name,
        Resultat = result,
        Kamptype = cluster_name,
        Point = points,
        xG = XG,
        Skud = SHOTS,
        `Skud på mål` = SHOTSONTARGET,
        Mål = GOALS,
        `Berøringer i feltet` = TOUCHESINBOX,
        Driblinger = DRIBBLES,
        `Progressive løb` = PROGRESSIVERUNS,
        `Gns. afslutningsafstand` = AVGDISTANCE
      ) %>%
      arrange(Hold, desc(Point), desc(xG))
    
    datatable(
      tbl,
      rownames = FALSE,
      filter = "top",
      options = list(
        pageLength = 12,
        autoWidth = TRUE,
        scrollX = TRUE
      )
    )
  })
  
  output$elbow <- renderPlot({
    ggplot(elbow_df, aes(k, wss)) +
      geom_line(linewidth = 1.1, color = brondby_blue) +
      geom_point(size = 3.5, color = brondby_yellow) +
      geom_vline(xintercept = 2, linetype = "dashed", color = "grey40") +
      labs(
        title = "Elbow plot for valg af antal clusters",
        subtitle = "Kurven peger på 2 meningsfulde kamptyper",
        x = "Antal clusters",
        y = "WSS"
      ) +
      theme_minimal(base_size = 13) +
      theme(
        plot.title = element_text(face = "bold"),
        plot.subtitle = element_text(color = muted_text),
        panel.grid.minor = element_blank()
      )
  })
  
  output$cluster_summary_table <- renderDT({
    tbl <- kamp_data %>%
      group_by(cluster_name) %>%
      summarise(
        `Antal kampe` = n(),
        `Gns. skud` = round(mean(SHOTS, na.rm = TRUE), 2),
        `Gns. xG` = round(mean(XG, na.rm = TRUE), 2),
        `Gns. mål` = round(mean(GOALS, na.rm = TRUE), 2),
        `Gns. skud på mål` = round(mean(SHOTSONTARGET, na.rm = TRUE), 2),
        `Gns. driblinger` = round(mean(DRIBBLES, na.rm = TRUE), 2),
        `Gns. berøringer i feltet` = round(mean(TOUCHESINBOX, na.rm = TRUE), 2),
        `Gns. frispark` = round(mean(FOULS, na.rm = TRUE), 2),
        `Gns. afslutningsafstand` = round(mean(AVGDISTANCE, na.rm = TRUE), 2),
        .groups = "drop"
      )
    
    datatable(
      tbl,
      rownames = FALSE,
      options = list(
        pageLength = 5,
        autoWidth = TRUE,
        scrollX = TRUE,
        dom = "t"
      )
    )
  })
}

shinyApp(ui, server)
