    touches_in_box = round(mean(TOUCHESINBOX, na.rm = TRUE), 2),
    .groups = "drop"
  ) %>%
  arrange(desc(xg))

# Plot af tabellen
modstander_cluster_plot <- kamp_data %>%
  filter(TEAMNAME == valgt_hold) %>%
  group_by(opponent_name, cluster_name) %>%
  summarise(antal_kampe = n(), .groups = "drop")

ggplot(modstander_cluster_plot,
       aes(x = opponent_name, y = antal_kampe, fill = cluster_name)) +
