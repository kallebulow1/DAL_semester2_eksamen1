# ---- Hent kampdata ----
kamp_data_query <- dbGetQuery(con3, "
SELECT
  g.MATCH_WYID,
  g.TEAM_WYID,
  t.TEAMNAME,
  g.SHOTS,
  g.FOULS,
  g.CORNERS,
  g.REDCARDS,
  g.YELLOWCARDS,
  g.OFFSIDES,
  g.DRIBBLES,
  g.GOALS,
  g.XGPERSHOT,
  g.AVGDISTANCE,
  g.XG,
  g.PROGRESSIVERUNS,
  g.TOUCHESINBOX,
  g.FOULSSUFFERED,
  g.SHOTSONTARGET,
  g.SHOTSBLOCKED,
  g.SHOTSOUTSIDEBOX,
  g.SHOTSOUTSIDEBOXONTARGET,
  g.SHOTSONPOST,
  g.SHOTSWIDE,
  g.SHOTSFROMBOX,
  g.SHOTSFROMBOXONTARGET,
  g.FREEKICKS,
  g.SHOTSFROMDANGERZONE,
  g.TOTALTHROWINS,
  g.LEFTTHROWINS,
  g.RIGHTTHROWINS,
  m.SEASON_WYID
FROM wyscout_matchadvancedstats_general g
JOIN wyscout_matches m
  ON g.MATCH_WYID = m.MATCH_WYID
LEFT JOIN wyscout_teams t
  ON g.TEAM_WYID = t.TEAM_WYID
WHERE m.SEASON_WYID = 191611
") %>%
  as_tibble()

str(kamp_data_query)

# ---- Fjern dubletter ----
kamp_data <- kamp_data_query %>%
  distinct(MATCH_WYID, TEAM_WYID, .keep_all = TRUE)

# ---- Lav modstander-data ----
modstander_data <- kamp_data %>%
  select(MATCH_WYID, TEAM_WYID, TEAMNAME, GOALS) %>%
  rename(
    opponent_team_wyid = TEAM_WYID,
    opponent_name = TEAMNAME,
    goals_against = GOALS
  )

# ---- Join modstander på ----
kamp_data <- kamp_data %>%
  left_join(modstander_data, by = "MATCH_WYID") %>%
  filter(TEAM_WYID != opponent_team_wyid) %>%
  distinct(MATCH_WYID, TEAM_WYID, .keep_all = TRUE)

# ---- Lav resultat ----
kamp_data <- kamp_data %>%
  mutate(
    result = case_when(
      GOALS > goals_against ~ "Sejr",
      GOALS == goals_against ~ "Uafgjort",
      GOALS < goals_against ~ "Nederlag"
    ),
    points = case_when(
      GOALS > goals_against ~ 3,
      GOALS == goals_against ~ 1,
      GOALS < goals_against ~ 0
    )
  )

# ---- Vælg variable til clustering ----
cluster_data <- kamp_data %>%
  select(
    SHOTS,
    FOULS,
    CORNERS,
    REDCARDS,
    YELLOWCARDS,
    OFFSIDES,
    DRIBBLES,
    GOALS,
    AVGDISTANCE,
    XG,
    PROGRESSIVERUNS,
    TOUCHESINBOX,
    FREEKICKS,
    TOTALTHROWINS,
  )

# ---- Fjern rækker med NA i cluster-variabler ----
kamp_data <- kamp_data %>%
  filter(complete.cases(cluster_data))

cluster_data <- kamp_data %>%
  select(
    SHOTS,
    FOULS,
    CORNERS,
    REDCARDS,
    YELLOWCARDS,
    OFFSIDES,
    DRIBBLES,
    GOALS,
    AVGDISTANCE,
    XG,
    PROGRESSIVERUNS,
    TOUCHESINBOX,
    FREEKICKS,
    TOTALTHROWINS,
  )

# ---- Standardiser data ----
cluster_scaled <- scale(cluster_data)

# ---- Elbow plot data ----
wss <- numeric(8) 
set.seed(123)
for (k in 1:8) {
  wss[k] <- kmeans(cluster_scaled, centers = k, nstart = 30)$tot.withinss
}

elbow_df <- data.frame(
  k = 1:8,
  wss = wss
)

# ---- elbow plot ----
ggplot(elbow_df, aes(x = k, y = wss)) +
  geom_line(linewidth = 1) +
  geom_point(size = 3) +
  geom_vline(xintercept = 2, linetype = "dashed", linewidth = 1) +
  scale_x_continuous(breaks = 1:8) +
  labs(
    title = "Elbow plot for valg af antal cluster",
    subtitle = "Et muligt knæk ses ved c = 2",
    x = "Antal cluster (c)",
    y = "WSS"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 22, face = "bold"),
    plot.subtitle = element_text(size = 16),
    axis.title = element_text(size = 16),
    axis.text = element_text(size = 13)
  )

# ---- K-means med 2 clusters ----
set.seed(123)
k_model <- kmeans(cluster_scaled, centers = 2, nstart = 50)

kamp_data$cluster <- as.factor(k_model$cluster)

# ---- Navngiv clusters ----
cluster_summary_raw <- kamp_data %>%
  group_by(cluster) %>%
  summarise(
    shots = mean(SHOTS, na.rm = TRUE),
    xg = mean(XG, na.rm = TRUE),
    goals = mean(GOALS, na.rm = TRUE),
    shots_on_target = mean(SHOTSONTARGET, na.rm = TRUE),
    touches_in_box = mean(TOUCHESINBOX, na.rm = TRUE),
    .groups = "drop"
  )

print(cluster_summary_raw)

# ---- Justér navnene hvis nødvendigt efter print ----
cluster_labels <- c(
  "2" = "Åbne og chanceprægede kampe",
  "1" = "Lukkede og chancefattige kampe"
)

kamp_data <- kamp_data %>%
  mutate(cluster_name = recode(cluster, !!!cluster_labels))

# ---- Cluster summary pæn tabel ----
cluster_summary_kamp <- kamp_data %>%
  group_by(cluster, cluster_name) %>%
  summarise(
    antal_rækker = n(),
    shots = round(mean(SHOTS, na.rm = TRUE), 2),
    xg = round(mean(XG, na.rm = TRUE), 2),
    goals = round(mean(GOALS, na.rm = TRUE), 2),
    shots_on_target = round(mean(SHOTSONTARGET, na.rm = TRUE), 2),
    dribbles = round(mean(DRIBBLES, na.rm = TRUE), 2),
    touches_in_box = round(mean(TOUCHESINBOX, na.rm = TRUE), 2),
    fouls = round(mean(FOULS, na.rm = TRUE), 2),
    avgdistance = round(mean(AVGDISTANCE, na.rm = TRUE), 2),
    .groups = "drop"
  )

# ---- Scatter plot ----
ggplot(kamp_data, aes(x = XG, y = SHOTS, color = cluster_name)) +
  geom_point(size = 3, alpha = 0.8) +
  scale_color_manual(values = c(
    "Lukkede og chancefattige kampe" = "#1f77b4",
    "Åbne og chanceprægede kampe" = "#2ca02c"
  )) +
  labs(
    title = "Kampprofiler i indeværende sæson",
    subtitle = "Sammenhæng mellem xG og antal skud",
    x = "xG",
    y = "Antal skud",
    color = "Cluster"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 22, face = "bold"),
    plot.subtitle = element_text(size = 16),
    axis.title = element_text(size = 16),
    axis.text = element_text(size = 13),
    legend.title = element_text(size = 15),
    legend.text = element_text(size = 13),
    legend.position = "bottom"
  )

# ---- Modstander analyse ----
# Viser hvor ofte hvert hold havner i hvert cluster mod forskellige modstandere.
modstander_cluster_tabel <- kamp_data %>%
  group_by(TEAMNAME, opponent_name, cluster_name) %>%
  summarise(antal_kampe = n(), .groups = "drop") %>%
  arrange(TEAMNAME, opponent_name, cluster_name)

# Gør det nemmere at sammenligne ved at gøre det til andele
modstander_cluster_andel <- kamp_data %>%
  group_by(TEAMNAME, opponent_name, cluster_name) %>%
  summarise(antal_kampe = n(), .groups = "drop") %>%
  group_by(TEAMNAME, opponent_name) %>%
  mutate(
    andel = antal_kampe / sum(antal_kampe)
  ) %>%
  ungroup() %>%
  arrange(TEAMNAME, opponent_name, desc(andel))

# ---- Gns. nøgetal for brøndby
# Vælg hold
valgt_hold <- "Brøndby"

# Lav tabel med gennemsnitlige kampnøgletal mod hver modstander
# ---- Kort og rapportvenlig tabel ----
modstander_gennemsnit_kort <- kamp_data %>%
  filter(TEAMNAME == valgt_hold) %>%
  group_by(opponent_name) %>%
  summarise(
    antal_kampe = n(),
    shots = round(mean(SHOTS, na.rm = TRUE), 2),
