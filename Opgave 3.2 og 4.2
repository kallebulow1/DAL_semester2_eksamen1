pretty_var <- function(x) {
  dplyr::case_when(
    x == "XG" ~ "xG",
    x == "SHOTS" ~ "Antal skud",
    x == "GOALS" ~ "Mål",
    x == "SHOTSONTARGET" ~ "Skud på mål",
    x == "TOUCHESINBOX" ~ "Berøringer i feltet",
    x == "DRIBBLES" ~ "Driblinger",
    x == "FOULS" ~ "Begåede frispark",
    x == "CORNERS" ~ "Hjørnespark",
    x == "PROGRESSIVERUNS" ~ "Progressive løb",
    x == "AVGDISTANCE" ~ "Gns. afslutningsafstand",
    x == "FREEKICKS" ~ "Frispark",
    x == "TOTALTHROWINS" ~ "Indkast i alt",
    TRUE ~ x
