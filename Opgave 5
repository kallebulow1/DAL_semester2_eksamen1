library(jsonlite)

# 1. Matematisk funktion til trekant-tjek
is_opponent_in_tri <- function(ox, oy, sx, sy) {
  # Areal-metoden til at tjekke om modstander (ox,oy) er i trekant fra (sx,sy) til mål
  area <- function(x1, y1, x2, y2, x3, y3) {
    abs((x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)) / 2)
  }
  total_area <- area(sx, sy, 120, 36, 120, 44)
  a1 <- area(ox, oy, sx, sy, 120, 36)
  a2 <- area(ox, oy, 120, 36, 120, 44)
  a3 <- area(ox, oy, 120, 44, sx, sy)
  return(abs(total_area - (a1 + a2 + a3)) < 0.1)
}

# 2. Beregn Ego-rate med fejlhåndtering (undgår NULL filter-fejl)
calc_ego_rate <- function(df) {
  # VIGTIGT: Fjern skud uden freeze_frame for at undgå NULL-fejl
  shots <- df %>% 
    filter(type.name == "Shot") %>% 
    filter(!sapply(shot.freeze_frame, is.null))
  
  results <- sapply(1:nrow(shots), function(i) {
    ff <- shots$shot.freeze_frame[[i]]
    sx <- shots$location[[i]][1]; sy <- shots$location[[i]][2]
    
    opps <- ff %>% filter(teammate == FALSE)
    s_blocked <- sum(mapply(is_opponent_in_tri, 
                            sapply(opps$location, `[`, 1), 
                            sapply(opps$location, `[`, 2), 
                            MoreArgs = list(sx=sx, sy=sy)))
    
    tms <- ff %>% filter(teammate == TRUE)
    if(nrow(tms) == 0) return(FALSE)
    
    tm_better <- any(sapply(1:nrow(tms), function(j) {
      tx <- tms$location[[j]][1]; ty <- tms$location[[j]][2]
      tm_blocked <- sum(mapply(is_opponent_in_tri, 
                               sapply(opps$location, `[`, 1), 
                               sapply(opps$location, `[`, 2), 
                               MoreArgs = list(sx=tx, sy=ty)))
      return(tm_blocked < s_blocked)
    }))
    return(tm_better)
  })
  return(mean(results, na.rm = TRUE) * 100)
}

