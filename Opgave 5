# --- MATEMATIKKEN (Formidling) ---
# Vi bruger 'Area Method' til at tjekke om et punkt (modstander) ligger i en trekant (skudlinjen).
# Formel: Area = 0.5 * |x1(y2 - y3) + x2(y3 - y1) + x3(y1 - y2)|
calc_tri_area <- function(x1, y1, x2, y2, x3, y3) {
  abs((x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)) / 2)
}

is_opponent_in_tri <- function(ox, oy, sx, sy) {
  g1x <- 120; g1y <- 36 # Venstre målstolpe
  g2x <- 120; g2y <- 44 # Højre målstolpe
  
  total_area <- calc_tri_area(sx, sy, g1x, g1y, g2x, g2y)
  a1 <- calc_tri_area(ox, oy, sx, sy, g1x, g1y)
  a2 <- calc_tri_area(ox, oy, g1x, g1y, g2x, g2y)
  a3 <- calc_tri_area(ox, oy, g2x, g2y, sx, sy)
  
  return(abs(total_area - (a1 + a2 + a3)) < 0.05)
}

