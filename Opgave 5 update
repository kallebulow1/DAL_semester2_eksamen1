# ============================================================
# CASE VISUAL (EGO)
# ============================================================

plot_case <- function(shot_row){
  
  ff <- shot_row$shot.freeze_frame[[1]]
  sx <- shot_row$x
  sy <- shot_row$y
  
  df <- data.frame(
    px = sapply(ff$location, function(l) l[1]),
    py = sapply(ff$location, function(l) l[2]),
    teammate = ff$teammate
  )
  
  df$col <- ifelse(df$teammate, "Medspiller", "Modstander")
  
  tri <- data.frame(
    x = c(sx, 120, 120),
    y = c(sy, 36, 44)
  )
  
  ggplot() +
    annotate_pitch(dimensions = pitch_statsbomb, fill = "#2e7d32") +
    
    geom_polygon(data = tri, aes(x = x, y = y),
                 fill = "yellow", alpha = 0.3) +
    
    geom_point(data = df, aes(x = px, y = py, color = col),
               size = 4) +
    
    geom_point(aes(x = sx, y = sy),
               color = "gold", size = 6) +
    
    scale_color_manual(values = c(
      "Medspiller" = "#1976d2",
      "Modstander" = "black"
    )) +
    
    coord_flip(xlim = c(49,121)) +
    scale_y_reverse() +
    
    theme_pitch() +
    
    labs(
      title = "Beslutningssituation (trekant + pres)"
    )
}

# CASES
case_ego <- shots %>% filter(ego == TRUE) %>% slice(1)
case_good <- shots %>% filter(ego == FALSE) %>% slice(1)

plot_case(case_ego)
plot_case(case_good)

