# Funktion der henter spillerdata fra et frame
extract_players <- function(frame, team_name) {
  
  # Stop hvis frame er tomt
  if (is.null(frame)) return(NULL)
  
  # Kopiér frame
  df <- frame
  
  # Tilføj holdnavn
  df$team <- team_name
  
  # Split xyz til x, y og z
  coords <- do.call(rbind, df$xyz)
  colnames(coords) <- c("x", "y", "z")
  
  # Saml koordinater med resten af data
  df <- cbind(df, coords)
  
  # Fjern original xyz-kolonne
  df$xyz <- NULL
  
  # Returnér dataframe
  return(df)
}


#### SAML ALLE FRAMES ####
# Loop gennem alle frames og hent spillere
all_players <- lapply(1:nrow(vbob_json), function(i) {
  
  # Vælg ét frame
  frame <- vbob_json[i, ]
  
  # Hent hjemmehold
  home <- extract_players(frame$homePlayers[[1]], "home")
  
  # Hent udehold
  away <- extract_players(frame$awayPlayers[[1]], "away")
  
  # Saml begge hold
  players <- bind_rows(home, away)
  
  # Spring over hvis tomt
  if (is.null(players) || nrow(players) == 0) return(NULL)
  
  # Tilføj frame-id
  players$frameIdx <- frame$frameIdx
  
  # Tilføj halvleg/periode
  players$period <- frame$period
  
  # Returnér spillerdata
  return(players)
})

# Saml alle frames til én dataframe
players_df <- bind_rows(all_players)

