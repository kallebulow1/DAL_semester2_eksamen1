#### FUNKTION TIL DELAUNAY-PLOT OMKRING MÅLET ####
plot_goal_delaunay <- function(frame_number) {
  
  # Hent spillere i valgt frame
  df <- players_df %>%
    filter(frameIdx == frame_number) %>%
    filter(!is.na(x), !is.na(y)) %>%
    distinct(playerId, .keep_all = TRUE)
  
  # Stop hvis der er for få spillere
  if (nrow(df) < 4) {
    message("For få spillere i dette frame")
    return(NULL)
  }
  
  # Hent boldens position i valgt frame
  ball <- vbob %>%
    filter(V1 == frame_number) %>%
    transmute(
      x = V69,
      y = V70
    )
  
  # Stop hvis bolden mangler
  if (nrow(ball) == 0) {
    message("Ingen bolddata i dette frame")
    return(NULL)
  }
  
  # Beregn Delaunay-triangulering ud fra spillernes positioner
  dd <- deldir::deldir(df$x, df$y)
  
  # Hent linjestykkerne fra trianguleringen
  segs <- dd$delsgs
  
  # Lav data til midtercirklen
  circle <- data.frame(
    x = 9.15 * cos(seq(0, 2 * pi, length.out = 200)),
    y = 9.15 * sin(seq(0, 2 * pi, length.out = 200))
  )
  
  # Lav plot
  ggplot() +
    
    # Tegn hele banen med mørk baggrund
    geom_rect(aes(xmin = -52.5, xmax = 52.5, ymin = -34, ymax = 34),
              fill = "#0D0D0D", color = "#CFCFCF", linewidth = 0.7) +
    
    # Tegn midterlinjen
    geom_segment(aes(x = 0, y = -34, xend = 0, yend = 34),
                 color = "#CFCFCF", linewidth = 0.45, alpha = 0.85) +
    
    # Tegn midtercirklen
    geom_path(data = circle,
              aes(x = x, y = y),
              color = "#CFCFCF", linewidth = 0.45, alpha = 0.85) +
    
    # Tegn venstre straffesparksfelt
    geom_rect(aes(xmin = -52.5, xmax = -36, ymin = -20.16, ymax = 20.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn højre straffesparksfelt
    geom_rect(aes(xmin = 36, xmax = 52.5, ymin = -20.16, ymax = 20.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn venstre målfelt
    geom_rect(aes(xmin = -52.5, xmax = -47, ymin = -9.16, ymax = 9.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn højre målfelt
    geom_rect(aes(xmin = 47, xmax = 52.5, ymin = -9.16, ymax = 9.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn venstre mållinje
    geom_segment(aes(x = -52.5, y = -4, xend = -52.5, yend = 4),
                 color = "#FFD700", linewidth = 1) +
    
    # Tegn højre mållinje
    geom_segment(aes(x = 52.5, y = -4, xend = 52.5, yend = 4),
                 color = "#FFD700", linewidth = 1) +
    
    # Tegn Delaunay-linjer mellem spillerne
    geom_segment(data = segs,
                 aes(x = x1, y = y1, xend = x2, yend = y2),
                 color = "#E6E6E6", linewidth = 0.45, alpha = 0.75) +
    
    # Tegn spillerne
    geom_point(data = df,
               aes(x = x, y = y, fill = team_name),
               shape = 21, color = "white", stroke = 0.7, size = 5.3) +
    
    # Skriv spillernummer inde i punkterne
    geom_text(data = df,
              aes(x = x, y = y, label = number.x),
              color = "white", size = 3, fontface = "bold") +
    
    # Tegn bolden
    geom_point(data = ball,
               aes(x = x, y = y),
               shape = 21,
               fill = "#FFD700",
               color = "black",
               size = 5.5,
               stroke = 1.1) +
    
    # Lås koordinaterne så banen beholder de rigtige proportioner
    coord_cartesian(xlim = c(-55, 55), ylim = c(-34, 34)) +
    
    # Giv holdene rigtige farver og navne i legend F8766D
    scale_fill_manual(
      values = c(
        "Vejle Boldklub" = "#F8766D",
        "OB" = "#13C2C2"
      ),
      breaks = c("OB", "Vejle Boldklub")
    ) +
    
    # Tilføj titel og legend
    labs(
      title = ("OB scorer på trods af VB´s tætte forsvar"),
      subtitle = paste("Delauney - frame", frame_number),
      fill = NULL
    ) +
    
    # Fjern akser og giv et rent layout
    theme_void() +
    theme(
      plot.title = element_text(face = "bold", size = 14, hjust = 0.5, color = "white"),
      plot.subtitle = element_text(size = 11, hjust = 0.5, color = "#D9D9D9"),
      plot.background = element_rect(fill = "#0D0D0D", color = NA),
      panel.background = element_rect(fill = "#0D0D0D", color = NA),
      legend.position = "bottom",
      legend.direction = "horizontal",
      legend.text = element_text(color = "white", size = 12),
      legend.background = element_rect(fill = "#0D0D0D", color = NA),
      legend.key = element_rect(fill = "#0D0D0D", color = NA),
      plot.margin = margin(15, 15, 15, 15)
    ) +
    
    # Gør legend-punkterne lidt større og pænere
    guides(fill = guide_legend(
      override.aes = list(shape = 21, size = 7, color = "white", stroke = 0.7),
      nrow = 1
    ))
}







#### FUNKTION TIL VORONOI-PLOT OMKRING MÅLET ####
plot_goal_voronoi <- function(frame_number) {
  
  # Hent spillere i valgt frame
  df <- players_df %>%
    filter(frameIdx == frame_number) %>%
    filter(!is.na(x), !is.na(y)) %>%
    distinct(playerId, .keep_all = TRUE) %>%
    distinct(x, y, .keep_all = TRUE)
  
  # Stop hvis der er for få spillere
  if (nrow(df) < 4) {
    message("For få spillere i dette frame")
    return(NULL)
  }
  
  # Hent boldens position i valgt frame
  ball <- vbob %>%
    filter(V1 == frame_number) %>%
    transmute(
      x = V69,
      y = V70
    )
  
  # Stop hvis bolden mangler
  if (nrow(ball) == 0) {
    message("Ingen bolddata i dette frame")
    return(NULL)
  }
  
  # Beregn Voronoi-diagram ud fra spillernes positioner
  dd <- deldir::deldir(df$x, df$y, rw = c(-55, 55, -34, 34))
  
  # Hent Voronoi-cellerne
  tiles <- deldir::tile.list(dd)
  
  # Byg polygon-data så ggplot kan tegne cellerne
  poly_df <- purrr::map_dfr(seq_along(tiles), function(i) {
    
    # Vælg én celle
    tile <- tiles[[i]]
    
    # Spring over hvis cellen ikke kan danne en polygon
    if (length(tile$x) < 3 || length(tile$y) < 3) return(NULL)
    
    # Returnér koordinater til polygonen
    data.frame(
      x = c(tile$x, tile$x[1]),
      y = c(tile$y, tile$y[1]),
      id = i,
      team_name = df$team_name[i]
    )
  })
  
  # Stop hvis ingen polygoner kunne laves
  if (nrow(poly_df) == 0) {
    message("Ingen gyldige Voronoi-celler i dette frame")
    return(NULL)
  }
  
  # Lav data til midtercirklen
  circle <- data.frame(
    x = 9.15 * cos(seq(0, 2 * pi, length.out = 200)),
    y = 9.15 * sin(seq(0, 2 * pi, length.out = 200))
  )
  
  # Lav plot
  ggplot() +
    
    # Tegn hele banen med mørk baggrund
    geom_rect(aes(xmin = -52.5, xmax = 52.5, ymin = -34, ymax = 34),
              fill = "#0D0D0D", color = "#CFCFCF", linewidth = 0.7) +
    
    # Tegn midterlinjen
    geom_segment(aes(x = 0, y = -34, xend = 0, yend = 34),
                 color = "#CFCFCF", linewidth = 0.45, alpha = 0.85) +
    
    # Tegn midtercirklen
    geom_path(data = circle,
              aes(x = x, y = y),
              color = "#CFCFCF", linewidth = 0.45, alpha = 0.85) +
    
    # Tegn venstre straffesparksfelt
    geom_rect(aes(xmin = -52.5, xmax = -36, ymin = -20.16, ymax = 20.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn højre straffesparksfelt
    geom_rect(aes(xmin = 36, xmax = 52.5, ymin = -20.16, ymax = 20.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn venstre målfelt
    geom_rect(aes(xmin = -52.5, xmax = -47, ymin = -9.16, ymax = 9.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn højre målfelt
    geom_rect(aes(xmin = 47, xmax = 52.5, ymin = -9.16, ymax = 9.16),
              fill = NA, color = "#CFCFCF", linewidth = 0.45) +
    
    # Tegn venstre mållinje
    geom_segment(aes(x = -52.5, y = -4, xend = -52.5, yend = 4),
                 color = "#FFD700", linewidth = 1) +
    
    # Tegn højre mållinje
    geom_segment(aes(x = 52.5, y = -4, xend = 52.5, yend = 4),
                 color = "#FFD700", linewidth = 1) +
    
    # Tegn Voronoi-cellerne
    geom_polygon(data = poly_df,
                 aes(x = x, y = y, group = id, fill = team_name),
                 alpha = 0.16, color = "#E6E6E6", linewidth = 0.4) +
    
    # Tegn spillerne
    geom_point(data = df,
               aes(x = x, y = y, fill = team_name),
               shape = 21, color = "white", stroke = 0.7, size = 5.3) +
    
    # Skriv spillernummer inde i punkterne
    geom_text(data = df,
              aes(x = x, y = y, label = number.x),
              color = "white", size = 3, fontface = "bold") +
    
    # Tegn bolden
    geom_point(data = ball,
               aes(x = x, y = y),
               shape = 21,
               fill = "#FFD700",
               color = "black",
               size = 5.5,
               stroke = 1.1) +
    
    # Lås koordinaterne så banen beholder de rigtige proportioner
