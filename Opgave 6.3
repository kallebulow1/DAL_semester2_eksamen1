#### beregne spiller med mest areal udfra voronoi ####
#### FUNKTION TIL VORONOI-AREAL I MODSTANDERENS ZONE ####
calc_frame_voronoi_area <- function(frame_data, zone = "opponent_half") {
  
  # Rens data
  df <- frame_data %>%
    filter(!is.na(x), !is.na(y), !is.na(team), !is.na(playerId)) %>%
    distinct(playerId, .keep_all = TRUE) %>%
    distinct(x, y, .keep_all = TRUE)
  
  # Stop hvis der er for få spillere
  if (nrow(df) < 4) return(NULL)
  
  # Definér hele banen som polygon
  pitch_poly <- st_polygon(list(matrix(
    c(-52.5, -34,
      52.5, -34,
      52.5,  34,
      -52.5,  34,
      -52.5, -34),
    ncol = 2,
    byrow = TRUE
  )))
  
  pitch_sf <- st_sfc(pitch_poly)
  
  # Hjælpefunktion der laver den relevante zone for én spiller
  get_target_zone <- function(team_name, attacking_right_value, zone_type) {
    
    # Stop hvis angrebsretning mangler
    if (is.na(attacking_right_value)) return(NULL)
    
    # Hvis spilleren angriber mod højre
    if (attacking_right_value) {
      
      # Modstanderens halvdel = højre halvdel
      if (zone_type == "opponent_half") {
        zone_poly <- st_polygon(list(matrix(
          c(0,    -34,
            52.5, -34,
            52.5,  34,
            0,     34,
            0,    -34),
          ncol = 2,
          byrow = TRUE
        )))
      }
      
      # Modstanderens felt = højre straffesparksfelt
      if (zone_type == "opponent_box") {
        zone_poly <- st_polygon(list(matrix(
          c(36,   -20.16,
            52.5, -20.16,
            52.5,  20.16,
            36,    20.16,
            36,   -20.16),
          ncol = 2,
          byrow = TRUE
        )))
      }
      
    } else {
      
      # Modstanderens halvdel = venstre halvdel
      if (zone_type == "opponent_half") {
        zone_poly <- st_polygon(list(matrix(
          c(-52.5, -34,
            0,    -34,
            0,     34,
            -52.5,  34,
            -52.5, -34),
          ncol = 2,
          byrow = TRUE
        )))
      }
      
      # Modstanderens felt = venstre straffesparksfelt
      if (zone_type == "opponent_box") {
        zone_poly <- st_polygon(list(matrix(
          c(-52.5, -20.16,
            -36,   -20.16,
            -36,    20.16,
            -52.5,  20.16,
            -52.5, -20.16),
          ncol = 2,
          byrow = TRUE
        )))
      }
    }
    
    st_sfc(zone_poly)
  }
  
  # Beregn Voronoi-diagram for hele banen
  dd <- deldir::deldir(df$x, df$y, rw = c(-52.5, 52.5, -34, 34))
  tiles <- deldir::tile.list(dd)
  
  # Stop hvis ingen tiles
  if (length(tiles) == 0) return(NULL)
  
  # Gennemgå alle spillere og beregn areal i valgt zone
  result_list <- purrr::map_dfr(seq_along(tiles), function(i) {
    
    tile <- tiles[[i]]
    
    # Spring over ugyldige polygoner
    if (length(tile$x) < 3 || length(tile$y) < 3) return(NULL)
    
    # Lav Voronoi-polygon
    tile_poly <- st_polygon(list(cbind(
      c(tile$x, tile$x[1]),
      c(tile$y, tile$y[1])
    )))
    
    tile_sf <- st_sfc(tile_poly)
    
    # Klip polygon til banen
    tile_clipped <- suppressWarnings(st_intersection(tile_sf, pitch_sf))
    
    # Spring over hvis polygonen blev tom
    if (length(tile_clipped) == 0) return(NULL)
    if (all(st_is_empty(tile_clipped))) return(NULL)
    
    # Hent zonen for den konkrete spiller
    zone_sf <- get_target_zone(
      team_name = df$team[i],
      attacking_right_value = df$attacking_right[i],
      zone_type = zone
    )
    
    # Spring over hvis zone mangler
    if (is.null(zone_sf)) return(NULL)
    
    # Klip polygon til modstanderens zone
    zone_intersection <- suppressWarnings(st_intersection(tile_clipped, zone_sf))
    
    # Hvis spilleren ikke har noget areal i zonen, sættes arealet til 0
    if (length(zone_intersection) == 0 || all(st_is_empty(zone_intersection))) {
      area_value <- 0
    } else {
      area_value <- as.numeric(sum(st_area(zone_intersection)))
    }
    
    # Returnér resultat for spilleren
    data.frame(
      frameIdx = df$frameIdx[i],
      period = df$period[i],
      team = df$team[i],
      playerId = df$playerId[i],
      name = df$name[i],
      number.x = df$number.x[i],
      x = df$x[i],
      y = df$y[i],
      attacking_right = df$attacking_right[i],
      voronoi_area = area_value
    )
  })
  
  # Stop hvis tomt resultat
  if (nrow(result_list) == 0) return(NULL)
  
  return(result_list)
}

# gør funktionen robust
safe_voronoi_calc <- purrr::possibly(calc_frame_voronoi_area, otherwise = NULL)

#### UDVÆLG FRAMES ####
# Tag fx hvert 50. frame for hurtigere beregning
sampled_frames <- players_df %>%
  distinct(frameIdx) %>%
  arrange(frameIdx) %>%
  slice(seq(1, n(), by = 250)) %>%
  pull(frameIdx)

#### BEREGN VORONOI-AREAL FOR ALLE UDVALGTE FRAMES ####
voronoi_results <- map_dfr(sampled_frames, function(f) {
  
  frame_data <- players_df %>% filter(frameIdx == f)
  
  safe_voronoi_calc(frame_data, zone = "opponent_half")
})


#### OPSUMMÉR VORONOI-RESULTATER ####
top_voronoi_players <- voronoi_results %>%
  group_by(team, playerId, name, number.x) %>%
  summarise(
    mean_area = mean(voronoi_area, na.rm = TRUE),
    median_area = median(voronoi_area, na.rm = TRUE),
    max_area = max(voronoi_area, na.rm = TRUE),
    n_frames = n(),
    .groups = "drop"
  ) %>%
  arrange(desc(mean_area))


#### TOP 10 SPILLERE MED STØRST VORONOI-AREAL ####
top10_voronoi <- top_voronoi_players %>%
  slice_max(order_by = mean_area, n = 10)


#### TILFØJ HOLDNAVNE OG LABELS ####
top10_voronoi <- top10_voronoi %>%
  mutate(
    team_name = case_when(
      team == "home" ~ "Vejle Boldklub",
      team == "away" ~ "OB",
      TRUE ~ team
    ),
    last_name = sub(".* ", "", name),
    label = paste0(last_name, " (#", number.x, ")")
  )


#### LAV SØJLEDIAGRAM FOR VORONOI-AREAL ####
ggplot(top10_voronoi, aes(x = reorder(label, mean_area), y = mean_area, fill = team_name)) +
  
