# Gør modelmatrix kompatibel med train_x fra den tidligere xG-model
# Funktion der sikrer, at vores nye data har PRÆCIS samme struktur som træningsdata
align_model_matrix <- function(new_matrix, reference_matrix) {
  
  # Finder kolonner der mangler i new_matrix ift. reference (train_x)
  missing_cols <- setdiff(colnames(reference_matrix), colnames(new_matrix))
  
  # Finder kolonner der er ekstra i new_matrix (som modellen ikke kender)
  extra_cols   <- setdiff(colnames(new_matrix), colnames(reference_matrix))
  
  # Hvis der mangler kolonner → tilføj dem med værdi 0
  if (length(missing_cols) > 0) {
    for (col in missing_cols) {
      new_matrix <- cbind(new_matrix, 0)  # tilføjer kolonne med 0
      colnames(new_matrix)[ncol(new_matrix)] <- col  # giver korrekt navn
    }
  }
  
  # Hvis der er ekstra kolonner → fjern dem
  if (length(extra_cols) > 0) {
    new_matrix <- new_matrix[, setdiff(colnames(new_matrix), extra_cols), drop = FALSE]
  }
  
  # Sørger for at kolonnerne er i samme rækkefølge som træningsdata
  new_matrix[, colnames(reference_matrix), drop = FALSE]
}

# Simulerer én kamp ud fra shot-level xG
simulate_match_xpoints <- function(match_id, team_1, team_2, shot_df, n_sims = 5000) {
  
  # Henter alle xG værdier (skud) for hold 1
  probs_1 <- shot_df %>%
    filter(MATCH_WYID == match_id, TEAM_WYID == team_1) %>%
    pull(xg)
  
  # Henter alle xG værdier (skud) for hold 2
  probs_2 <- shot_df %>%
    filter(MATCH_WYID == match_id, TEAM_WYID == team_2) %>%
    pull(xg)
  
  # Fjerner NA værdier (ellers crasher simulation)
  probs_1 <- probs_1[!is.na(probs_1)]
  probs_2 <- probs_2[!is.na(probs_2)]
  
  # Sørger for at sandsynligheder ligger mellem 0.01 og 0.99
  # (ellers kan rbinom opføre sig mærkeligt)
  probs_1 <- pmin(pmax(probs_1, 0.01), 0.99)
  probs_2 <- pmin(pmax(probs_2, 0.01), 0.99)
  
  # Simulerer antal mål for hold 1
  sim_goals_1 <- replicate(
    n_sims,
    if (length(probs_1) == 0) 0 else 
      sum(rbinom(length(probs_1), size = 1, prob = probs_1))
  )
  
  # Simulerer antal mål for hold 2
  sim_goals_2 <- replicate(
    n_sims,
    if (length(probs_2) == 0) 0 else 
      sum(rbinom(length(probs_2), size = 1, prob = probs_2))
  )
  
  # Beregner sandsynligheder for udfald
  win_1  <- mean(sim_goals_1 > sim_goals_2)   # hold 1 vinder
  draw_1 <- mean(sim_goals_1 == sim_goals_2)  # uafgjort
  loss_1 <- mean(sim_goals_1 < sim_goals_2)   # hold 1 taber
  
  # Samme for hold 2
  win_2  <- mean(sim_goals_2 > sim_goals_1)
  draw_2 <- mean(sim_goals_2 == sim_goals_1)
  loss_2 <- mean(sim_goals_2 < sim_goals_1)
  
  # Omregner til point (3-1-0 system)
  tibble(
    MATCH_WYID = match_id,
    TEAM_WYID  = c(team_1, team_2),
    xPoints    = c(3 * win_1 + 1 * draw_1, 3 * win_2 + 1 * draw_2),
    win_prob   = c(win_1, win_2),
    draw_prob  = c(draw_1, draw_2),
    loss_prob  = c(loss_1, loss_2)
  )
}

# Bygger faktiske mål og point fra MATCHLABEL
# Det er nødvendigt, fordi datasættet ikke er komplet på eventdata
build_actual_match_long <- function(matches_tbl, competition_id, season_id) {
  
  matches_results_tbl <- matches_tbl %>%
    mutate(
      teams_part    = str_trim(str_extract(MATCHLABEL, "^[^,]+")),
      score_part    = str_trim(str_extract(MATCHLABEL, "[0-9]+\\s*-\\s*[0-9]+$")),
      home_team_raw = str_trim(str_extract(teams_part, "^[^-]+")),
      away_team_raw = str_trim(str_extract(teams_part, "(?<=- ).*")),
      home_goals    = as.numeric(str_extract(score_part, "^[0-9]+")),
      away_goals    = as.numeric(str_extract(score_part, "(?<=-\\s)[0-9]+"))
    )
  
  # Tilføj den ene manglende kamp manuelt
  missing_result_row <- tibble(
    MATCH_WYID       = 5585758,
    MATCHLABEL       = "SønderjyskE - Midtjylland, 3 - 2",
    DATE             = as.POSIXct("2024-10-20 18:00:00", tz = "UTC"),
    DATEUTC          = as.POSIXct("2024-10-20 16:00:00", tz = "UTC"),
    MATCHSTATUS      = "Played",
    COMPETITION_WYID = competition_id,
    SEASON_WYID      = season_id,
    ROUND_WYID       = NA_integer_,
    GAMEWEEK         = 12,
    teams_part       = "SønderjyskE - Midtjylland",
    score_part       = "3 - 2",
    home_team_raw    = "SønderjyskE",
    away_team_raw    = "Midtjylland",
    home_goals       = 3,
    away_goals       = 2
  )
  
  matches_results_tbl <- bind_rows(matches_results_tbl, missing_result_row)
  
  team_name_lookup <- tribble(
    ~label_name,    ~team_name,
    "København",    "FC København",
    "Brøndby",      "Brøndby IF",
    "AaB",          "Aalborg BK",
    "Midtjylland",  "FC Midtjylland",
    "Viborg",       "Viborg FF",
    "AGF",          "AGF",
    "Nordsjælland", "FC Nordsjælland",
    "Silkeborg",    "Silkeborg IF",
    "Randers",      "Randers FC",
    "Vejle",        "Vejle Boldklub",
    "Lyngby",       "Lyngby Boldklub",
    "Sønderjyske",  "SønderjyskE",
    "SønderjyskE",  "SønderjyskE"
  )
  
  matches_results_tbl %>%
    select(MATCH_WYID, DATE, home_team_raw, away_team_raw, home_goals, away_goals) %>%
    pivot_longer(
      cols = c(home_team_raw, away_team_raw),
      names_to = "home_away",
      values_to = "label_name"
    ) %>%
    left_join(team_name_lookup, by = "label_name") %>%
    mutate(
      goals_for = ifelse(home_away == "home_team_raw", home_goals, away_goals),
      goals_against = ifelse(home_away == "home_team_raw", away_goals, home_goals),
      actual_points = case_when(
        goals_for > goals_against ~ 3,
        goals_for == goals_against ~ 1,
        TRUE ~ 0
      )
    ) %>%
    select(MATCH_WYID, DATE, team_name, goals_for, goals_against, actual_points)
}

