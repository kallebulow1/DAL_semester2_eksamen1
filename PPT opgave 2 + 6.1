## =========================================================
## 7) Hent og klargør skuddata
## =========================================================

season_shots_raw <- dbGetQuery(con, paste0("
WITH possession_start AS (
  SELECT
    POSSESSION_WYID,
    PRIMARYTYPE AS possession_start_type,
    ROW_NUMBER() OVER (
      PARTITION BY POSSESSION_WYID
      ORDER BY MATCH_WYID, MATCHPERIOD, MINUTE, SECOND, MATCHTIMESTAMP
    ) AS rn
  FROM wyscout_matchevents_common
  WHERE SEASON_WYID = ", season_id, "
    AND POSSESSION_WYID IS NOT NULL
)

SELECT
  s.EVENT_WYID,
  e.MATCH_WYID,
  e.MINUTE,
  e.SECOND,
  e.LOCATIONX,
  e.LOCATIONY,
  e.TEAM_WYID,
  e.OPPONENTTEAM_WYID,
  e.PLAYER_WYID,
  e.POSSESSION_WYID,
  e.POSSESSIONDURATION,
  s.SHOTISGOAL,
  s.SHOTBODYPART,
  ps.possession_start_type
FROM wyscout_matchevents_shots s
JOIN wyscout_matchevents_common e
  ON s.EVENT_WYID = e.EVENT_WYID
LEFT JOIN possession_start ps
  ON e.POSSESSION_WYID = ps.POSSESSION_WYID
 AND ps.rn = 1
WHERE e.SEASON_WYID = ", season_id, "
  AND e.COMPETITION_WYID = ", competition_id, "
  AND LOWER(e.PRIMARYTYPE) = 'shot';
")) %>%
  as_tibble() %>%
  distinct(EVENT_WYID, .keep_all = TRUE) %>%
  mutate(
    # Samme mål-logik som i din tidligere løsning
    is_goal = as.integer(
      SHOTISGOAL == 1 | str_detect(tolower(SHOTBODYPART), "goal")
    )
  )

## =========================================================
## 8) Feature engineering til xG-modellen
## =========================================================

season_model_data <- season_shots_raw %>%
  mutate(
    bodypart = case_when(
      str_detect(tolower(SHOTBODYPART), "head") ~ "head",
      str_detect(tolower(SHOTBODYPART), "left_foot") ~ "foot",
      str_detect(tolower(SHOTBODYPART), "right_foot") ~ "foot",
      str_detect(tolower(SHOTBODYPART), "foot") ~ "foot",
      TRUE ~ "foot"
    ),
    set_piece_category = case_when(
      tolower(possession_start_type) == "corner" ~ "corner",
      tolower(possession_start_type) %in% c("free_kick", "penalty") ~ "free_kick_or_penalty",
      tolower(possession_start_type) %in% c("throw_in", "goal_kick") ~ "restart_other",
      TRUE ~ "open_play"
    ),
    x_meter = LOCATIONX * 105 / 100,
    y_meter = LOCATIONY * 68 / 100,
    distance_meter = sqrt((105 - x_meter)^2 + (34 - y_meter)^2),
    goal_left_y  = 34 - 7.32 / 2,
    goal_right_y = 34 + 7.32 / 2,
    d_left  = sqrt((105 - x_meter)^2 + (goal_left_y - y_meter)^2),
    d_right = sqrt((105 - x_meter)^2 + (goal_right_y - y_meter)^2),
    cos_angle = (d_left^2 + d_right^2 - 7.32^2) / (2 * d_left * d_right),
    cos_angle = pmin(pmax(cos_angle, -1), 1),
    angle_deg = acos(cos_angle) * 180 / pi,
    possession_duration = POSSESSIONDURATION
  ) %>%
  filter(
    !is.na(distance_meter),
    !is.na(angle_deg),
    distance_meter < 60,
    angle_deg < 120
  ) %>%
  mutate(
    bodypart = factor(bodypart, levels = c("head", "foot", "other")),
    set_piece_category = factor(
      set_piece_category,
      levels = c("open_play", "corner", "free_kick_or_penalty", "restart_other")
    )
  )

## =========================================================
## 9) Scor alle skud med xG-modellen
## =========================================================

# Laver modelmatrix (gør kategoriske variable til dummy-variabler)
season_x <- model.matrix(
  ~ distance_meter + angle_deg + bodypart +
    possession_duration + set_piece_category - 1,
  data = season_model_data
)

# Sørger for at matrix matcher træningsdata (meget vigtigt)
season_x <- align_model_matrix(season_x, train_x)

# Bruger XGBoost model til at forudsige xG for hvert skud
season_model_data$xg <- predict(xgb_model, season_x)

# Rens xG-output og kalibrér til realistisk kampniveau
season_model_data <- season_model_data %>%
  mutate(
    xg = as.numeric(xg),       # sikrer korrekt datatype
    xg = ifelse(is.na(xg), 0, xg),  # NA → 0
    xg = pmax(xg, 0),          # minimum 0
    xg = pmin(xg, 1)           # maksimum 1
  )

# Finder gennemsnitlig xG pr kamp pr hold
current_team_match_xg <- season_model_data %>%
  group_by(MATCH_WYID, TEAM_WYID) %>%
  summarise(team_match_xg = sum(xg, na.rm = TRUE), .groups = "drop") %>%
  summarise(mean_xg = mean(team_match_xg, na.rm = TRUE)) %>%
  pull(mean_xg)

# Vi ønsker realistisk niveau (ca. 1.4 mål pr kamp)
target_team_match_xg <- 1.40

# Skaleringsfaktor
scaling_factor <- target_team_match_xg / current_team_match_xg

# Justerer xG
season_model_data <- season_model_data %>%
  mutate(
    xg = xg * scaling_factor,
    xg = pmin(xg, 1)
  )

## =========================================================
## 10) Aggregér til kampniveau
## =========================================================

# Faktiske mål fra shot-data
actual_goals_by_team <- season_shots_raw %>%
  group_by(MATCH_WYID, TEAM_WYID) %>%
  summarise(
    goals_for = sum(is_goal, na.rm = TRUE),
    raw_shots = n(),
    .groups = "drop"
  )

# xG på kampniveau
xg_by_team <- season_model_data %>%
  group_by(MATCH_WYID, TEAM_WYID) %>%
  summarise(
    model_shots = n(),
    xg_for = sum(xg, na.rm = TRUE),
    avg_xg_per_shot = mean(xg, na.rm = TRUE),
    .groups = "drop"
  )

# Spejling til modstander-perspektiv
actual_goals_opp <- actual_goals_by_team %>%
  rename(
    OPPONENTTEAM_WYID = TEAM_WYID,
    goals_against = goals_for,
    opp_raw_shots = raw_shots
  )

xg_opp <- xg_by_team %>%
  rename(
    OPPONENTTEAM_WYID = TEAM_WYID,
    opp_model_shots = model_shots,
    xg_against = xg_for,
    opp_avg_xg_per_shot = avg_xg_per_shot
  )

# Samlet kampniveau-data
match_team_stats <- match_team_universe %>%
  
  # Beholder kun relevante kampe
  semi_join(matches_tbl, by = "MATCH_WYID") %>%
  
  # Tilføjer kampinfo
  left_join(matches_tbl, by = "MATCH_WYID") %>%
  
  # Tilføjer holdnavne
  left_join(teams_tbl %>% select(TEAM_WYID, team_name), by = "TEAM_WYID") %>%
  
  # Tilføjer modstander
  left_join(
    teams_tbl %>%
      select(TEAM_WYID, team_name) %>%
      rename(OPPONENTTEAM_WYID = TEAM_WYID, opponent_name = team_name),
    by = "OPPONENTTEAM_WYID"
  ) %>%
  
  # Tilføjer mål og xG
  left_join(actual_goals_by_team, by = c("MATCH_WYID", "TEAM_WYID")) %>%
  left_join(xg_by_team, by = c("MATCH_WYID", "TEAM_WYID")) %>%
  left_join(actual_goals_opp, by = c("MATCH_WYID", "OPPONENTTEAM_WYID")) %>%
  left_join(xg_opp, by = c("MATCH_WYID", "OPPONENTTEAM_WYID")) %>%
  
  # Håndterer manglende værdier
  mutate(
    goals_for = coalesce(goals_for, 0L),
    goals_against = coalesce(goals_against, 0L),
    xg_for = coalesce(xg_for, 0),
    xg_against = coalesce(xg_against, 0),
    
    # Beregner faktiske point
    actual_points = case_when(
      goals_for > goals_against ~ 3,
      goals_for == goals_against ~ 1,
      TRUE ~ 0
    )
  ) %>%
  
  # Sikrer én række pr hold pr kamp
  distinct(MATCH_WYID, TEAM_WYID, .keep_all = TRUE)

