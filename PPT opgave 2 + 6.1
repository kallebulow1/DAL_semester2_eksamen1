    D  = as.integer(goals_for == goals_against),
    L  = as.integer(goals_for < goals_against),
    GD = goals_for - goals_against
  ) %>%
  group_by(TEAM_WYID, team_name) %>%
  summarise(
    M   = n_distinct(MATCH_WYID),
    W   = sum(W, na.rm = TRUE),
    D   = sum(D, na.rm = TRUE),
    L   = sum(L, na.rm = TRUE),
    G   = sum(goals_for, na.rm = TRUE),
    GA  = sum(goals_against, na.rm = TRUE),
    GD  = sum(GD, na.rm = TRUE),
    PTS = sum(actual_points, na.rm = TRUE),
    xG  = sum(xg_for, na.rm = TRUE),
    xGA = sum(xg_against, na.rm = TRUE),
    xPTS = sum(xPoints, na.rm = TRUE),
    PTS_minus_xPTS = PTS - xPTS,
    .groups = "drop"
  ) %>%
  arrange(desc(PTS), desc(GD), desc(G)) %>%
  mutate(
    Rank = row_number(),
    xG   = round(xG, 2),
    xGA  = round(xGA, 2),
    xPTS = round(xPTS, 2),
    PTS_minus_xPTS = round(PTS_minus_xPTS, 2)
  ) %>%
  select(Rank, team_name, M, W, D, L, G, GA, PTS, xG, xGA, xPTS, PTS_minus_xPTS)

