# funktion til at hente eventdata
get_sb_data <- function(match_id) {
  url <- paste0("https://raw.githubusercontent.com/statsbomb/open-data/master/data/events/", match_id, ".json")
  tryCatch(fromJSON(url, flatten = TRUE), error = function(e) NULL)
}

# hent alle kampe (kvinde EM 2022)
matches <- fromJSON("https://raw.githubusercontent.com/statsbomb/open-data/master/data/matches/53/106.json", flatten = TRUE)

match_ids <- matches$match_id

# hent eventdata
events_list <- map(match_ids, get_sb_data)
events <- bind_rows(events_list)

# =========================
# 2) FILTRER SKUD
# =========================
shots <- events %>%
  filter(type.name == "Shot")

# =========================
# 3) EKSTRAHER KOORDINATER
# =========================

shots <- shots %>%
  mutate(
    shx = map_dbl(location, 1),
    shy = map_dbl(location, 2)
  )

# =========================
# 4) TOP 10 MÅLSCORERE
# =========================

goalrank <- shots %>%
  filter(shot.outcome.name == "Goal") %>%
  group_by(player.name) %>%
  summarise(goals = n()) %>%
  arrange(desc(goals)) %>%
  slice_head(n = 10)

# plot
ggplot(goalrank, aes(x = reorder(player.name, goals), y = goals)) +
  geom_col(fill = "#2E8B57") +
  coord_flip() +
  labs(title = "Top 10 målscorere EM 2022 (kvinder)",
       x = "Spiller",
       y = "Antal mål")

# =========================
# 5) FEATURE ENGINEERING
# =========================

# afstand
shots <- shots %>%
  mutate(
    distance = sqrt((120 - shx)^2 + (40 - shy)^2)
  )

# vinkel funktion
angle_to_goal <- function(x, y) {
  goal_left  <- c(120, 36)
  goal_right <- c(120, 44)
  
  v1 <- c(goal_left[1] - x, goal_left[2] - y)
  v2 <- c(goal_right[1] - x, goal_right[2] - y)
  
  dot <- sum(v1 * v2)
  len1 <- sqrt(sum(v1^2))
  len2 <- sqrt(sum(v2^2))
  
  angle <- acos(dot / (len1 * len2))
  return(angle)
}

# beregn vinkel
shots <- shots %>%
  rowwise() %>%
  mutate(angle = angle_to_goal(shx, shy)) %>%
  ungroup()

# konverter til grader + meter
shots <- shots %>%
  mutate(
    angle_deg = angle * 180 / pi,
    distance_m = distance * 0.87
  )

